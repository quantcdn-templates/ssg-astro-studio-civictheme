---
/**
 * CivicTheme Layout component.
 *
 * Props:
 * - hideSidebarLeft: Whether to hide the left sidebar.
 * - hideSidebarRight: Whether to hide the right sidebar.
 * - isContained: Whether the page content should be contained.
 * - verticalSpacing: Controls vertical spacing (top, bottom, or both).
 * - contentAttributes: HTML attributes for the main content section.
 * - sidebarTopLeftAttributes: HTML attributes for the top-left sidebar.
 * - sidebarTopRightAttributes: HTML attributes for the top-right sidebar.
 * - sidebarBottomLeftAttributes: HTML attributes for the bottom-left sidebar.
 * - sidebarBottomRightAttributes: HTML attributes for the bottom-right sidebar.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Slots:
 * - default: Main content.
 * - contentTop: Main content area top content.
 * - contentBottom: Main content area bottom content.
 * - sidebarTopLeft: Top left sidebar content.
 * - sidebarTopRight: Top right sidebar content.
 * - sidebarBottomLeft: Bottom left sidebar content.
 * - sidebarBottomRight: Bottom right sidebar content.
 *
 * Every slot also has a same-named `string` prop (`content` feeds the
 * default slot), rendered with `set:html`; the slot TAKES PRECEDENCE when
 * present. Upstream's `layout.stories.js` passes all seven as plain HTML
 * strings, which is the shape a Drupal `layout.twig` caller uses too.
 */
interface Props {
  hideSidebarLeft?: boolean;
  hideSidebarRight?: boolean;
  isContained?: boolean;
  verticalSpacing?: 'top' | 'bottom' | 'both' | string | null;
  contentAttributes?: Record<string, unknown>;
  sidebarTopLeftAttributes?: Record<string, unknown>;
  sidebarTopRightAttributes?: Record<string, unknown>;
  sidebarBottomLeftAttributes?: Record<string, unknown>;
  sidebarBottomRightAttributes?: Record<string, unknown>;
  content?: string;
  contentTop?: string;
  contentBottom?: string;
  sidebarTopLeft?: string;
  sidebarTopRight?: string;
  sidebarBottomLeft?: string;
  sidebarBottomRight?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  hideSidebarLeft = false,
  hideSidebarRight = false,
  isContained: isContainedProp = false,
  verticalSpacing: verticalSpacingProp,
  contentAttributes = {},
  sidebarTopLeftAttributes = {},
  sidebarTopRightAttributes = {},
  sidebarBottomLeftAttributes = {},
  sidebarBottomRightAttributes = {},
  content,
  contentTop,
  contentBottom,
  sidebarTopLeft,
  sidebarTopRight,
  sidebarBottomLeft,
  sidebarBottomRight,
  class: modifierClass = '',
  ...rest
} = Astro.props;

const hasContentSlot = Astro.slots.has('default');
const hasContentTopSlot = Astro.slots.has('contentTop');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasSidebarTopLeftSlot = Astro.slots.has('sidebarTopLeft');
const hasSidebarTopRightSlot = Astro.slots.has('sidebarTopRight');
const hasSidebarBottomLeftSlot = Astro.slots.has('sidebarBottomLeft');
const hasSidebarBottomRightSlot = Astro.slots.has('sidebarBottomRight');

const hasContent = hasContentSlot || Boolean(content);
const hasContentTop = hasContentTopSlot || Boolean(contentTop);
const hasContentBottom = hasContentBottomSlot || Boolean(contentBottom);
const hasSidebarTopLeft = hasSidebarTopLeftSlot || Boolean(sidebarTopLeft);
const hasSidebarTopRight = hasSidebarTopRightSlot || Boolean(sidebarTopRight);
const hasSidebarBottomLeft = hasSidebarBottomLeftSlot || Boolean(sidebarBottomLeft);
const hasSidebarBottomRight = hasSidebarBottomRightSlot || Boolean(sidebarBottomRight);

const hasSidebarLeft = (hasSidebarTopLeft || hasSidebarBottomLeft) && !hideSidebarLeft;
const hasSidebarRight = (hasSidebarTopRight || hasSidebarBottomRight) && !hideSidebarRight;

const isContained = isContainedProp || hasSidebarLeft || hasSidebarRight;
const verticalSpacing = hasSidebarLeft || hasSidebarRight ? 'top' : verticalSpacingProp;

const noSidebarLeftClass = hideSidebarLeft ? 'ct-layout--no-sidebar-left' : '';
const noSidebarRightClass = hideSidebarRight ? 'ct-layout--no-sidebar-right' : '';
const noTlClass = !hasSidebarTopLeft || hideSidebarLeft ? 'ct-layout--no-top-left' : '';
const noTrClass = !hasSidebarTopRight || hideSidebarRight ? 'ct-layout--no-top-right' : '';
const noBlClass = !hasSidebarBottomLeft || hideSidebarLeft ? 'ct-layout--no-bottom-left' : '';
const noBrClass = !hasSidebarBottomRight || hideSidebarRight ? 'ct-layout--no-bottom-right' : '';
const isContainedClass = isContained ? 'container' : 'container-fluid';
const verticalSpacingClass = (['top', 'bottom', 'both'] as const).includes(verticalSpacing as 'top')
  ? `ct-vertical-spacing--${verticalSpacing}`
  : '';

const classes = [
  noSidebarLeftClass,
  noSidebarRightClass,
  noTlClass,
  noTrClass,
  noBlClass,
  noBrClass,
  verticalSpacingClass,
  modifierClass,
]
  .join(' ')
  .trim();
---

{
  hasContent && (
    <div class={`ct-layout ${classes}`} {...rest}>
      {hasContentTop && (hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />)}
      {hasContentTop && ' '}
      <div class={`ct-layout__inner ${isContainedClass}`}>
        <section class="ct-layout__main" {...contentAttributes}>
          {hasContentSlot ? <slot /> : <Fragment set:html={content} />}
        </section>
        {hasSidebarTopLeft && hasSidebarLeft && (
          <Fragment>
            {' '}
            <aside class="ct-layout__sidebar_top_left" {...sidebarTopLeftAttributes}>
              {hasSidebarTopLeftSlot ? <slot name="sidebarTopLeft" /> : <Fragment set:html={sidebarTopLeft} />}
            </aside>
          </Fragment>
        )}
        {hasSidebarTopRight && hasSidebarRight && (
          <Fragment>
            {' '}
            <aside class="ct-layout__sidebar_top_right" {...sidebarTopRightAttributes}>
              {hasSidebarTopRightSlot ? <slot name="sidebarTopRight" /> : <Fragment set:html={sidebarTopRight} />}
            </aside>
          </Fragment>
        )}
        {hasSidebarBottomLeft && hasSidebarLeft && (
          <Fragment>
            {' '}
            <aside class="ct-layout__sidebar_bottom_left" {...sidebarBottomLeftAttributes}>
              {hasSidebarBottomLeftSlot ? <slot name="sidebarBottomLeft" /> : <Fragment set:html={sidebarBottomLeft} />}
            </aside>
          </Fragment>
        )}
        {hasSidebarBottomRight && hasSidebarRight && (
          <Fragment>
            {' '}
            <aside class="ct-layout__sidebar_bottom_right" {...sidebarBottomRightAttributes}>
              {hasSidebarBottomRightSlot ? (
                <slot name="sidebarBottomRight" />
              ) : (
                <Fragment set:html={sidebarBottomRight} />
              )}
            </aside>
          </Fragment>
        )}
      </div>
      {hasContentBottom && (
        <Fragment>
          {' '}
          {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
        </Fragment>
      )}
    </div>
  )
}
