---
/**
 * CivicTheme Icon component.
 *
 * Props:
 * - symbol: Icon name (required to render anything).
 * - size: Icon size (extra-small, small, regular, large, extra-large).
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <svg>.
 */
import { icons, type IconSymbol } from './icons';

interface Props {
  symbol?: IconSymbol | string | null;
  size?: 'extra-small' | 'small' | 'regular' | 'large' | 'extra-large' | string | null;
  class?: string;
  [key: string]: unknown;
}

const { symbol, size, class: className = '', ...rest } = Astro.props;
const svg = symbol ? (icons as Record<string, string>)[symbol] : undefined;
const classes = ['ct-icon', size && `ct-icon--size-${size}`, ...className.split(' ')].filter(Boolean).join(' ');
// Values are interpolated into a raw HTML string below (not JSX attribute
// binding), so `&` and `"` must be escaped ourselves to avoid breaking the
// surrounding `"..."` attribute-value quoting or double-escaping entities.
const escapeAttr = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
// Attribute NAMES arrive from `...rest` (a caller-controlled spread) and are
// interpolated into the same raw HTML string, where an invalid name could
// close the tag or inject a second attribute. Only well-formed XML/HTML
// attribute names are kept; anything else is dropped.
const isValidAttrName = (name: string) => /^[a-zA-Z_:][-a-zA-Z0-9_:.]*$/.test(name);
const attrs = Object.entries({ class: classes, 'aria-hidden': 'true', role: 'img', ...rest })
  .filter(([k]) => isValidAttrName(k))
  .map(([k, v]) => `${k}="${escapeAttr(String(v))}"`)
  .join(' ');
const html = svg ? svg.replace('<svg ', `<svg ${attrs} `) : '';
---

{html && <Fragment set:html={html} />}
