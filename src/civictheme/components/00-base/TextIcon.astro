---
/**
 * CivicTheme Text Icon component.
 *
 * Props:
 * - text: Text content.
 * - isNewWindow: Whether to open in a new window.
 * - isExternal: Whether the link is external.
 * - icon: Icon name.
 * - iconPlacement: Icon position (before or after; default after).
 * - iconClass: Class for the icon.
 * - iconGroupDisabled: Whether to disable icon and last-word grouping.
 * - iconSingleOnly: Whether to show only one icon (external takes preference
 *   over `icon` when both are present).
 *
 * Note: upstream's `attributes` prop is declared in the Twig doc header but
 * never applied to any rendered element there — this port matches that
 * (unused) upstream behaviour rather than inventing a root element to spread
 * it onto. See PORTING.md.
 */
import Icon from './Icon.astro';

interface Props {
  text?: string | null;
  isNewWindow?: boolean | null;
  isExternal?: boolean | null;
  icon?: string | null;
  iconPlacement?: 'before' | 'after' | null;
  iconClass?: string;
  iconGroupDisabled?: boolean;
  iconSingleOnly?: boolean;
}

const {
  text,
  isNewWindow = false,
  isExternal: isExternalProp,
  icon,
  iconPlacement: iconPlacementProp,
  iconClass = '',
  iconGroupDisabled = false,
  iconSingleOnly = false,
} = Astro.props;

const isExternal = Boolean(isExternalProp);
const resolvedIcon = isExternal && iconSingleOnly ? 'upper-right-arrow' : (icon ?? '');
const iconPlacement = iconPlacementProp === 'before' ? 'before' : 'after';
const hasIconOrExternal = Boolean(resolvedIcon) || Boolean(isExternal);

let textStart = '';
let textEnd = '';
let showFullText = true;
if (text) {
  const words = text
    .replace(/<[^>]*>/g, '')
    .trim()
    .split(' ');
  textStart = words.slice(0, -1).join(' ');
  textEnd = words.at(-1) ?? '';
  // text-icon.twig: `show_full_text = icon_group_disabled or (icon_placement
  // == 'before' and is_external == false)` — verified empirically (a
  // throwaway probe template run against upstream's real Twig.js engine)
  // that `undefined == false` evaluates to FALSE in Twig.js (unlike PHP
  // Twig's loose-comparison rules), so this condition is only true when
  // `is_external` is the LITERAL boolean `false`, never when it is simply
  // omitted/undefined. `link.twig` passes `is_external` straight through
  // with no default (unlike `icon_group_disabled`/`icon_single_only`, which
  // it does default), so an omitted `isExternal` here must NOT count as
  // "not external" for this specific check — it must resolve `showFullText`
  // to `false` (grouped/last-word rendering), matching Breadcrumb's mobile
  // "parent" link snapshot (icon placement 'before', `isExternal` never
  // passed). `isExternalProp === false` (strict), not the Boolean-coerced
  // `isExternal` used everywhere else in this component, is what
  // reproduces that quirk.
  showFullText = iconGroupDisabled || (iconPlacement === 'before' && isExternalProp === false);
}
const displayText = showFullText ? text : `${textStart} `;
// text-icon.twig: `{%- if show_full_text %} {% endif -%}` emits a literal
// single space at the end of `after_text` only when `show_full_text` is
// true (regardless of whether any icon follows it) — that space is what
// ends up directly before `is_new_window_content` in the real markup, via
// `{{- content_markup -}}{{- is_new_window_content -}}` (both tightly
// trimmed, so the ONLY separator between them is this one, conditional,
// literal space). Every other content_markup branch (grouped/not-full-text,
// icon-only, plain-span-no-icon) is wrapped in tags that trim tightly on
// both sides, so none of them leave any space before is_new_window_content.
const spaceBeforeNewWindow = Boolean(hasIconOrExternal && text && showFullText);
---

{
  hasIconOrExternal ? (
    text ? (
      <Fragment>
        {iconPlacement === 'before' && resolvedIcon && (
          <Fragment>
            <Icon symbol={resolvedIcon} class={iconClass} />{' '}
          </Fragment>
        )}
        <span class="ct-text-icon__text" set:html={displayText} />
        {showFullText ? (
          <Fragment>
            {' '}
            {iconPlacement === 'after' && resolvedIcon && <Icon symbol={resolvedIcon} class={iconClass} />}
            {isExternal && !iconSingleOnly && <Icon symbol="upper-right-arrow" />}
          </Fragment>
        ) : (
          <span class="ct-text-icon__group">
            <span class="ct-text-icon__text">{textEnd}</span>{' '}
            {iconPlacement === 'after' && resolvedIcon && <Icon symbol={resolvedIcon} class={iconClass} />}
            {isExternal && !iconSingleOnly && <Icon symbol="upper-right-arrow" />}
          </span>
        )}
      </Fragment>
    ) : (
      resolvedIcon && <Icon symbol={resolvedIcon} class={iconClass} />
    )
  ) : (
    <span class="ct-text-icon__text" set:html={text} />
  )
}
{
  isNewWindow && (
    <Fragment>
      {spaceBeforeNewWindow && ' '}
      <span class="ct-visually-hidden">(Opens in a new tab/window)</span>
    </Fragment>
  )
}
