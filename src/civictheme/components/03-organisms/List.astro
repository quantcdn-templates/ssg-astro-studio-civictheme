---
/**
 * CivicTheme List component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - verticalSpacing: List vertical spacing (top, bottom, or both).
 * - withBackground: Whether to display with a background.
 * - linkAbove / linkBelow: Link objects: { text, url, isNewWindow, isExternal }.
 * - rowsAbove / rowsBelow: Above/below rows content — a string or array of
 *   strings; each entry is concatenated raw (matching the un-trimmed-once
 *   `{%- rows_above_row -%}` loop upstream, which drops all inter-row
 *   whitespace). Gated on the RAW prop's own truthiness (`list.twig:139,163`
 *   — `{% if rows_above -%}` / `{% if rows_below %}`, an array's
 *   Twig-truthiness being "non-empty array"), not on the joined HTML
 *   string — a non-empty array of all-empty-string rows still opens the
 *   container even though its joined content is `''`.
 * - title / content / filters / resultsCount / rows / empty / pagination /
 *   footer: Documented as Slots upstream. Every upstream test passes plain
 *   string props, so each is still typed as a `string` prop and rendered
 *   with `set:html` per this project's autoescape convention — but each
 *   also now has a same-named Astro slot (camelCase) that TAKES
 *   PRECEDENCE over the string prop when present, so a real composed
 *   Astro tree (e.g. `<Fragment slot="rows">`) can be passed instead of a
 *   pre-rendered HTML string. Every existing wrapper `{% if %}` gate is
 *   widened to `Boolean(prop) || Astro.slots.has('prop')` so a slot alone
 *   (with no string prop set) still opens its wrapper markup.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: `empty_block` gates on `empty is defined and (rows is not defined
 * or rows is empty)` — the "is defined" half of that can't be replicated
 * exactly with plain props (every prop key is always "defined" once
 * destructured), so this ports it as `!rows && (typeof empty !==
 * 'undefined' || Astro.slots.has('empty'))`, which matches every upstream
 * test case.
 */
import Heading from '@civictheme/atoms/Heading.astro';
import Button from '@civictheme/atoms/Button.astro';
import Paragraph from '@civictheme/atoms/Paragraph.astro';

interface ListLink {
  text?: string;
  url?: string;
  isNewWindow?: boolean;
  isExternal?: boolean;
}

interface Props {
  theme?: 'light' | 'dark';
  verticalSpacing?: 'top' | 'bottom' | 'both' | string | null;
  withBackground?: boolean;
  linkAbove?: ListLink | null;
  linkBelow?: ListLink | null;
  rowsAbove?: string | string[];
  rowsBelow?: string | string[];
  title?: string;
  content?: string;
  filters?: string;
  resultsCount?: string;
  rows?: string;
  empty?: string;
  pagination?: string;
  footer?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  verticalSpacing,
  withBackground,
  linkAbove,
  linkBelow,
  rowsAbove,
  rowsBelow,
  title,
  content,
  filters,
  resultsCount,
  rows,
  empty,
  pagination,
  footer,
  class: className = '',
  ...rest
} = Astro.props;

const verticalSpacingClass = (['top', 'bottom', 'both'] as const).includes(verticalSpacing as 'top')
  ? `ct-vertical-spacing-inset--${verticalSpacing}`
  : '';

const classes = [
  'ct-list',
  `ct-theme-${theme}`,
  withBackground && 'ct-list--with-background',
  verticalSpacingClass,
  className,
]
  .filter(Boolean)
  .join(' ');

const hasLinkAbove = Boolean(linkAbove && Object.keys(linkAbove).length > 0);
const hasLinkBelow = Boolean(linkBelow && Object.keys(linkBelow).length > 0);

// Slot-vs-string-prop precedence: every Slot-documented prop from
// list.twig's doc header gets a same-named check here. When the slot is
// present it takes precedence over the string prop, and its own wrapper
// `{% if %}` gate widens to "string prop OR slot" so a slot-only usage
// still opens the wrapper markup.
const hasTitleSlot = Astro.slots.has('title');
const hasContentSlot = Astro.slots.has('content');
const hasFiltersSlot = Astro.slots.has('filters');
const hasResultsCountSlot = Astro.slots.has('resultsCount');
const hasRowsSlot = Astro.slots.has('rows');
const hasEmptySlot = Astro.slots.has('empty');
const hasPaginationSlot = Astro.slots.has('pagination');
const hasFooterSlot = Astro.slots.has('footer');

const hasHeader = Boolean(title || hasTitleSlot || hasLinkAbove);
const hasRows = Boolean(rows) || hasRowsSlot;
const hasEmpty = !hasRows && (typeof empty !== 'undefined' || hasEmptySlot);

const toArray = (v: string | string[] | undefined): string[] => (v == null ? [] : Array.isArray(v) ? v : [v]);
// list.twig:139/163 gate `{% if rows_above -%}` / `{% if rows_below %}` on
// the RAW prop's own truthiness — an array's Twig-truthiness is "non-empty
// array" (independent of what its joined content looks like), so this must
// NOT be based on the joined HTML string (which could be empty even for a
// non-empty array of all-empty-string rows).
const hasRowsAbove = Boolean(Array.isArray(rowsAbove) ? rowsAbove.length > 0 : rowsAbove);
const hasRowsBelow = Boolean(Array.isArray(rowsBelow) ? rowsBelow.length > 0 : rowsBelow);
const rowsAboveHtml = toArray(rowsAbove).join('');
const rowsBelowHtml = toArray(rowsBelow).join('');
---

<div class={classes} {...rest}>
  <div class="ct-list__inner">
    {
      hasHeader && (
        <Fragment>
          <div class="ct-list__header">
            <div class="container">
              <div class="row">
                <div class="col-xxs-12 col-m-9">
                  {hasTitleSlot ? (
                    <slot name="title" />
                  ) : (
                    title && <Heading content={title} level={2} theme={theme} class="ct-list__title" />
                  )}
                </div>{' '}
                <div class="col-xxs-12 col-m-3">
                  {hasLinkAbove && (
                    <div class="ct-list__link-above ct-flex-justify-content-center">
                      <Button
                        theme={theme}
                        type="secondary"
                        kind="link"
                        size="regular"
                        text={linkAbove?.text}
                        url={linkAbove?.url}
                        isNewWindow={linkAbove?.isExternal}
                        isExternal={linkAbove?.isExternal}
                        icon={linkAbove?.isExternal ? '' : 'right-arrow-2'}
                        class="ct-list__link-above__link"
                      />
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>{' '}
        </Fragment>
      )
    }
    {
      (content || hasContentSlot) && (
        <Fragment>
          <div class="ct-list__content">
            <div class="container">
              <div class="row">
                <div class="col-xxs-12">
                  {hasContentSlot ? (
                    <slot name="content" />
                  ) : (
                    <Paragraph content={content} theme={theme} class="ct-list__content__inner" />
                  )}
                </div>
              </div>
            </div>
          </div>{' '}
        </Fragment>
      )
    }
    {
      (filters || hasFiltersSlot) && (
        <Fragment>
          <div class="ct-list__filters">
            <div class="container">
              <div class="row">
                {hasFiltersSlot ? (
                  <div class="col-xxs-12">
                    <slot name="filters" />
                  </div>
                ) : (
                  <div class="col-xxs-12" set:html={filters} />
                )}
              </div>
            </div>
          </div>{' '}
        </Fragment>
      )
    }
    {
      hasRows && (
        <Fragment>
          {hasRowsAbove && (
            <Fragment>
              <div class="container ct-list__rows-above">
                <div class="row">
                  <div class="col-xxs-12" set:html={rowsAboveHtml} />
                </div>
              </div>{' '}
            </Fragment>
          )}
          {(resultsCount || hasResultsCountSlot) && (
            <Fragment>
              <div class="container">
                <div class="row">
                  <div class="col-xxs-12">
                    <div class="ct-list__results-count">
                      {hasResultsCountSlot ? <slot name="resultsCount" /> : resultsCount}
                    </div>
                  </div>
                </div>
              </div>{' '}
            </Fragment>
          )}
          {hasRowsSlot ? (
            <div class="ct-list__rows">
              <slot name="rows" />
            </div>
          ) : (
            <div class="ct-list__rows" set:html={rows} />
          )}
          {hasRowsBelow && (
            <Fragment>
              {' '}
              <div class="container ct-list__rows-below">
                <div class="row">
                  <div class="col-xxs-12" set:html={rowsBelowHtml} />
                </div>
              </div>
            </Fragment>
          )}
        </Fragment>
      )
    }
    {
      hasEmpty && (
        <div class="container ct-list__empty-results">
          <div class="row">
            <div class="col-xxs-12">
              {hasEmptySlot ? (
                <slot name="empty" />
              ) : (
                <Paragraph content={empty} theme={theme} class="ct-list__empty-results__inner" />
              )}
            </div>
          </div>
        </div>
      )
    }
    {
      hasLinkBelow && (
        <Fragment>
          {' '}
          <div class="ct-list__link-below ct-flex-justify-content-center container">
            <Button
              theme={theme}
              type="secondary"
              kind="link"
              size="large"
              text={linkBelow?.text}
              url={linkBelow?.url}
              isNewWindow={linkBelow?.isExternal}
              isExternal={linkBelow?.isExternal}
              icon={linkBelow?.isExternal ? '' : 'right-arrow-2'}
              class="ct-list__link-below__link"
            />
          </div>
        </Fragment>
      )
    }
    {
      (pagination || hasPaginationSlot) && (
        <Fragment>
          {' '}
          <div class="ct-list__results-below">
            <div class="container">
              <div class="row">
                <div class="col-xxs-12">
                  {hasPaginationSlot ? (
                    <div class="ct-list__pagination">
                      <slot name="pagination" />
                    </div>
                  ) : (
                    <div class="ct-list__pagination" set:html={pagination} />
                  )}
                </div>
              </div>
            </div>
          </div>
        </Fragment>
      )
    }
    {
      (footer || hasFooterSlot) && (
        <Fragment>
          {' '}
          <footer class="ct-list__footer">
            <div class="container">
              <div class="row">
                {hasFooterSlot ? (
                  <div class="col-xxs-12">
                    <slot name="footer" />
                  </div>
                ) : (
                  <div class="col-xxs-12" set:html={footer} />
                )}
              </div>
            </div>
          </footer>
        </Fragment>
      )
    }
  </div>
</div>
