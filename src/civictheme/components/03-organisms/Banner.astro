---
/**
 * CivicTheme Banner component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - isDecorative: Whether to show as decorative.
 * - backgroundImageBlendMode: Background image blending type. Defaults to
 *   'normal'.
 * - breadcrumb: Breadcrumb navigation: { links, activeIsLink }.
 * - featuredImage / backgroundImage: { url, alt }.
 * - contentTop1 / contentTop2 / contentTop3 / siteSection / title /
 *   contentMiddle / content / contentBelow / contentBottom: Documented as
 *   Slots upstream, but every upstream test passes plain string props —
 *   ported as `string` props, rendered with `set:html` per this project's
 *   autoescape convention.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: `title_block`/`content_middle_block`/`content_block`/
 * `breadcrumb_block` all widen from `col-xxs-12` to `col-xxs-12 col-m-6`
 * whenever `featured_image` is present (making room for the image beside
 * them) — reproduced as `hasFeaturedImage ? '... col-m-6' : '...'` at each
 * of those four sites independently, matching the Twig's four separate
 * `{% if featured_image is not empty %}` guards.
 *
 * Note: `banner.twig:78,84` — `breadcrumb is not empty` / `featured_image
 * is not empty` are Twig's `empty` test on an OBJECT (property-count
 * check), not on `.links`/`.url` specifically — an object with any key at
 * all counts as non-empty, even `{ activeIsLink: true }` with no `links`,
 * or `{ alt: '...' }` with no `url`. `hasBreadcrumb`/`hasFeaturedImage`
 * use `Object.keys(x).length > 0` accordingly; `Image`'s own `url` gate
 * still governs whether an `<img>` actually renders inside the wrapper.
 */
import Breadcrumb from '@civictheme/molecules/Breadcrumb.astro';
import Heading from '@civictheme/atoms/Heading.astro';
import Image from '@civictheme/atoms/Image.astro';

interface Props {
  theme?: 'light' | 'dark';
  isDecorative?: boolean;
  backgroundImageBlendMode?: string;
  breadcrumb?: { links?: Array<{ text?: string; url?: string }>; activeIsLink?: boolean };
  featuredImage?: { url?: string; alt?: string };
  backgroundImage?: { url?: string; alt?: string };
  contentTop1?: string;
  contentTop2?: string;
  contentTop3?: string;
  siteSection?: string;
  title?: string;
  contentMiddle?: string;
  content?: string;
  contentBelow?: string;
  contentBottom?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  isDecorative,
  backgroundImageBlendMode,
  breadcrumb,
  featuredImage,
  backgroundImage,
  contentTop1,
  contentTop2,
  contentTop3,
  siteSection,
  title,
  contentMiddle,
  content,
  contentBelow,
  contentBottom,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['ct-banner', `ct-theme-${theme}`, isDecorative && 'ct-banner--decorative', className]
  .filter(Boolean)
  .join(' ');

// banner.twig:78,84 — `breadcrumb is not empty` / `featured_image is not
// empty` are Twig's `empty` test on an OBJECT, which checks property
// count, not `.links.length`/`.url` specifically — an object with any key
// at all (even one with no `links`, or no `url`) counts as non-empty.
const hasBreadcrumb = Boolean(breadcrumb && Object.keys(breadcrumb).length > 0);
const hasFeaturedImage = Boolean(featuredImage && Object.keys(featuredImage).length > 0);
const hasBackgroundImageUrl = Boolean(backgroundImage?.url);
const hasBackgroundImageAlt = Boolean(backgroundImage?.alt);

// Slot-vs-string-prop precedence (same convention as `List.astro`): every
// Slot-documented prop from banner.twig's doc header gets a same-named named
// slot. When the slot is present it takes precedence over the string prop,
// and every `{% if %}` gate widens to "string prop OR slot" so a slot-only
// usage still opens the wrapper markup.
const hasContentTop1Slot = Astro.slots.has('contentTop1');
const hasContentTop2Slot = Astro.slots.has('contentTop2');
const hasContentTop3Slot = Astro.slots.has('contentTop3');
const hasSiteSectionSlot = Astro.slots.has('siteSection');
const hasTitleSlot = Astro.slots.has('title');
const hasContentMiddleSlot = Astro.slots.has('contentMiddle');
const hasContentSlot = Astro.slots.has('content');
const hasContentBelowSlot = Astro.slots.has('contentBelow');
const hasContentBottomSlot = Astro.slots.has('contentBottom');

const hasContentTop1 = Boolean(contentTop1) || hasContentTop1Slot;
const hasContentTop2 = Boolean(contentTop2) || hasContentTop2Slot;
const hasContentTop3 = Boolean(contentTop3) || hasContentTop3Slot;
const hasSiteSection = Boolean(siteSection) || hasSiteSectionSlot;
const hasTitle = Boolean(title) || hasTitleSlot;
const hasContentMiddle = Boolean(contentMiddle) || hasContentMiddleSlot;
const hasContent = Boolean(content) || hasContentSlot;
const hasContentBelow = Boolean(contentBelow) || hasContentBelowSlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;

const shouldRender =
  hasContentTop1 ||
  hasContentTop2 ||
  hasContentTop3 ||
  hasSiteSection ||
  hasTitle ||
  hasContentMiddle ||
  hasContent ||
  hasContentBelow ||
  hasContentBottom;

const innerClasses = ['ct-banner__inner', backgroundImageBlendMode && `ct-background--${backgroundImageBlendMode}`]
  .filter(Boolean)
  .join(' ');
const contentColClass = hasFeaturedImage ? 'col-xxs-12 col-m-6' : 'col-xxs-12';
---

{
  shouldRender && (
    <div class={classes} {...rest}>
      <div class="ct-banner__wrapper">
        <div
          class={innerClasses}
          style={hasBackgroundImageUrl ? `background-image: url('${backgroundImage?.url}');` : undefined}
        >
          {hasBackgroundImageAlt && (
            <Fragment>
              <span role="img" aria-label={backgroundImage?.alt}>
                {' '}
              </span>{' '}
            </Fragment>
          )}
          <div class="container">
            {hasContentTop1 && (
              <Fragment>
                <div class="row">
                  <div class="col-xxs-12">
                    <div class="ct-banner__content-top">
                      {hasContentTop1Slot ? <slot name="contentTop1" /> : <Fragment set:html={contentTop1} />}
                    </div>
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {(hasBreadcrumb || hasContentTop2) && (
              <Fragment>
                <div class="row">
                  {hasBreadcrumb && (
                    <div class={hasFeaturedImage ? 'col-xxs-12 col-m-6' : 'col-xxs-12'}>
                      <Breadcrumb
                        theme={theme}
                        links={breadcrumb?.links}
                        activeIsLink={breadcrumb?.activeIsLink}
                        class="ct-banner__breadcrumb"
                      />
                    </div>
                  )}{' '}
                  {hasContentTop2 && (
                    <div class="col-xxs-12 col-m-6">
                      <div class="ct-banner__content-top2">
                        {hasContentTop2Slot ? <slot name="contentTop2" /> : <Fragment set:html={contentTop2} />}
                      </div>
                    </div>
                  )}
                </div>{' '}
              </Fragment>
            )}
            {hasContentTop3 && (
              <Fragment>
                <div class="row">
                  <div class="col-xxs-12">
                    <div class="ct-banner__content-top3">
                      {hasContentTop3Slot ? <slot name="contentTop3" /> : <Fragment set:html={contentTop3} />}
                    </div>
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {hasSiteSection && (
              <Fragment>
                <div class="row">
                  <div class="col-xxs-12">
                    {hasSiteSectionSlot ? (
                      <slot name="siteSection" />
                    ) : (
                      <Heading theme={theme} content={siteSection} level={5} class="ct-banner__site-section" />
                    )}
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {hasTitle && (
              <Fragment>
                <div class="row">
                  <div class={contentColClass}>
                    {hasTitleSlot ? (
                      <slot name="title" />
                    ) : (
                      <Heading theme={theme} content={title} level={1} class="ct-banner__title" />
                    )}
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {hasContentMiddle && (
              <Fragment>
                <div class="row">
                  <div class={contentColClass}>
                    <div class="ct-banner__content-middle">
                      {hasContentMiddleSlot ? <slot name="contentMiddle" /> : <Fragment set:html={contentMiddle} />}
                    </div>
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {hasContent && (
              <div class="row">
                <div class={contentColClass}>
                  <div class="ct-banner__content">
                    {hasContentSlot ? <slot name="content" /> : <Fragment set:html={content} />}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>{' '}
        {hasFeaturedImage && (
          <div class="ct-banner__featured-image__wrapper">
            <Image theme={theme} url={featuredImage?.url} alt={featuredImage?.alt} class="ct-banner__featured-image" />
          </div>
        )}
      </div>{' '}
      {hasContentBelow && (
        <Fragment>
          <div class="container">
            <div class="row">
              <div class="col-xxs-12">
                <div class="ct-banner__content-below">
                  {hasContentBelowSlot ? <slot name="contentBelow" /> : <Fragment set:html={contentBelow} />}
                </div>
              </div>
            </div>
          </div>{' '}
        </Fragment>
      )}
      {hasContentBottom && (
        <div class="container">
          <div class="row">
            <div class="col-xxs-12">
              <div class="ct-banner__content-bottom">
                {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
