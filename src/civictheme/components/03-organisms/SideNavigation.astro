---
/**
 * CivicTheme Side Navigation component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - verticalSpacing: Navigation vertical spacing (top, bottom, or both).
 * - items: Menu items (see `Menu.astro`'s `MenuItem`).
 * - title: Navigation title.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
import Heading from '@civictheme/atoms/Heading.astro';
import Menu from '@civictheme/base/Menu.astro';
import SkipLink from '@civictheme/organisms/SkipLink.astro';

interface MenuItem {
  title?: string;
  url?: string;
  inActiveTrail?: boolean;
  isExpanded?: boolean;
  below?: MenuItem[];
}

interface Props {
  theme?: 'light' | 'dark';
  verticalSpacing?: 'top' | 'bottom' | 'both' | string;
  items?: MenuItem[];
  title?: string;
  class?: string;
  [key: string]: unknown;
}

const { theme = 'light', verticalSpacing, items = [], title, class: className = '', ...rest } = Astro.props;

const themeClass = `ct-theme-${theme}`;
const verticalSpacingClass = ['top', 'bottom', 'both'].includes(verticalSpacing ?? '')
  ? `ct-vertical-spacing-inset--${verticalSpacing}`
  : '';
const classes = `ct-side-navigation ${themeClass} ${verticalSpacingClass} ${className}`;
---

{
  items.length > 0 && (
    <div class={classes} {...rest}>
      <SkipLink theme={theme} url="#main-content" />{' '}
      {title && (
        <Fragment>
          <Heading content={title} level={2} theme={theme} class="ct-side-navigation__title" />{' '}
        </Fragment>
      )}
      <Menu theme={theme} items={items} class="ct-side-navigation__menu" isCollapsible={true} />
    </div>
  )
}
