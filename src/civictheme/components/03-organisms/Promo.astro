---
/**
 * CivicTheme Promo component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - isContained: Whether the content is contained in a container.
 * - verticalSpacing: Vertical spacing for the promo (top, bottom, or both).
 * - withBackground: Whether to display with a background.
 * - link: Call-to-action link ({ text, url, isNewWindow, isExternal }).
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Slots (rendered with `set:html`, per this project's autoescape-off
 * convention — html-bearing string props):
 * - contentTop: Top content area.
 * - title: Title text.
 * - content: Main content text.
 * - contentBottom: Bottom promo content.
 *
 * Each also now has a same-named Astro slot that TAKES PRECEDENCE over the
 * string prop when present (Task 14c); every wrapper `{% if %}` gate
 * (root included, via `title`/`content`) widens to
 * `Boolean(prop) || Astro.slots.has('prop')`. `title`/`content` route the
 * string-prop branch through `Heading`/`Paragraph`, so a slot bypasses
 * those wrappers and renders the caller's markup directly.
 */
import Heading from '@civictheme/atoms/Heading.astro';
import Paragraph from '@civictheme/atoms/Paragraph.astro';
import Button from '@civictheme/atoms/Button.astro';

interface PromoLink {
  text?: string;
  url?: string;
  isNewWindow?: boolean;
  isExternal?: boolean;
}

interface Props {
  theme?: 'light' | 'dark';
  isContained?: boolean;
  verticalSpacing?: 'top' | 'bottom' | 'both' | string;
  withBackground?: boolean;
  link?: PromoLink | null;
  contentTop?: string;
  title?: string;
  content?: string;
  contentBottom?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  isContained,
  verticalSpacing,
  withBackground,
  link,
  contentTop,
  title,
  content,
  contentBottom,
  class: className = '',
  ...rest
} = Astro.props;

const themeClass = `ct-theme-${theme}`;
const withBackgroundClass = withBackground ? 'ct-promo--with-background' : '';
const verticalSpacingClass = ['top', 'bottom', 'both'].includes(verticalSpacing ?? '')
  ? `ct-vertical-spacing--${verticalSpacing}`
  : '';
const classes = `ct-promo ${themeClass} ${withBackgroundClass} ${verticalSpacingClass} ${className}`;

const contained = isContained === undefined ? true : isContained;

// `{% if link %}` — Twig's plain truthy test on an object is also a
// property-count check (same underlying `count()` Twig's `empty` test
// uses), so `link: {}` is falsy, same as `null`/absent. Matches the
// Banner/Promo `is not empty` review-fix semantics already documented in
// PORTING.md, just reached via a different Twig operator.
const hasLink = Object.keys(link ?? {}).length > 0;

const hasContentTopSlot = Astro.slots.has('contentTop');
const hasTitleSlot = Astro.slots.has('title');
const hasContentSlot = Astro.slots.has('content');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasTitle = Boolean(title) || hasTitleSlot;
const hasContent = Boolean(content) || hasContentSlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;
---

{
  (hasTitle || hasContent) &&
    (() => {
      const inner = (
        <Fragment>
          {hasContentTop && (
            <Fragment>
              <div class="ct-promo__content-top">
                {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
              </div>{' '}
            </Fragment>
          )}
          <div class="ct-promo__wrapper">
            <div class="ct-promo__inner">
              {hasTitle &&
                (hasTitleSlot ? (
                  <slot name="title" />
                ) : (
                  title && <Heading content={title} level={4} theme={theme} class="ct-promo__title" />
                ))}{' '}
              {hasContent &&
                (hasContentSlot ? (
                  <slot name="content" />
                ) : (
                  content && <Paragraph theme={theme} content={content} class="ct-promo__content" />
                ))}
            </div>{' '}
            {hasLink && (
              <div class="ct-promo__links">
                <Button
                  theme={theme}
                  type="secondary"
                  kind="link"
                  size="large"
                  text={link?.text}
                  url={link?.url}
                  isNewWindow={link?.isNewWindow ?? false}
                  isExternal={link?.isExternal ?? false}
                  class="ct-promo__button"
                />
              </div>
            )}
          </div>{' '}
          {hasContentBottom && (
            <div class="ct-promo__content-bottom">
              {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
            </div>
          )}
        </Fragment>
      );

      return (
        <div class={classes} {...rest}>
          {contained ? (
            <div class="container">
              <div class="row">
                <div class="col-xxs-12">{inner}</div>
              </div>
            </div>
          ) : (
            inner
          )}
        </div>
      );
    })()
}
