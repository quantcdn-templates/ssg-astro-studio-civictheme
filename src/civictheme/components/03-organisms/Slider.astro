---
/**
 * CivicTheme Slider component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - previousLabel: Text for the previous button.
 * - nextLabel: Text for the next button.
 * - verticalSpacing: Slider vertical spacing (top, bottom, or both).
 * - withBackground: Whether to display with a background.
 * - slides: Slides HTML content (rendered with `set:html`; typically a
 *   sequence of ported `<Slide>` markup, pre-rendered by the caller).
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Slots (rendered with `set:html`, per this project's autoescape-off
 * convention — html-bearing string props):
 * - contentTop: Top content.
 * - title: Slider title.
 * - contentBottom: Bottom content.
 *
 * Each also now has a same-named Astro slot that TAKES PRECEDENCE over the
 * string prop when present (Task 14c); their wrapper `{% if %}` gates
 * widen to `Boolean(prop) || Astro.slots.has('prop')`. `title` routes the
 * string-prop branch through `Heading`, so a slot bypasses that wrapper.
 * The root `aria-label` uses the `title` slot's text (tags stripped) when
 * the slot is present, then the `title` prop, then `'Slider'`.
 * `slides` is NOT slotted: it is not documented as a Slot upstream (it is
 * a plain "Props:" entry — pre-rendered slide markup supplied by the
 * caller, same treatment as before).
 *
 * Note: the progress-indicator `<Tag>`'s content is the literal string
 * `'Slide 1'` regardless of slide count — `slider.js`'s vendored behaviour
 * updates it at runtime (`data-slider-progress`); this is not a bug, it
 * mirrors `slider.twig`'s own hardcoded `content: 'Slide 1'`.
 */
import Heading from '@civictheme/atoms/Heading.astro';
import Button from '@civictheme/atoms/Button.astro';
import Tag from '@civictheme/atoms/Tag.astro';

interface Props {
  theme?: 'light' | 'dark';
  previousLabel?: string;
  nextLabel?: string;
  verticalSpacing?: 'top' | 'bottom' | 'both' | string;
  withBackground?: boolean;
  slides?: string;
  contentTop?: string;
  title?: string;
  contentBottom?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  previousLabel,
  nextLabel,
  verticalSpacing,
  withBackground,
  slides,
  contentTop,
  title,
  contentBottom,
  class: className = '',
  ...rest
} = Astro.props;

const themeClass = `ct-theme-${theme}`;
const withBackgroundClass = withBackground ? 'ct-slider--with-background' : '';
const verticalSpacingClass = ['top', 'bottom', 'both'].includes(verticalSpacing ?? '')
  ? `ct-vertical-spacing-inset--${verticalSpacing}`
  : '';
const classes = `ct-slider ${themeClass} ${withBackgroundClass} ${verticalSpacingClass} ${className}`;

const hasContentTopSlot = Astro.slots.has('contentTop');
const hasTitleSlot = Astro.slots.has('title');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasTitle = Boolean(title) || hasTitleSlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;

// The root `aria-label` reads the title as plain text. A `title` slot is
// rendered once here — printed below via `set:html` — and its text (tags
// stripped, named and numeric entities decoded) takes precedence over the prop.
const ENTITIES: Record<string, string> = { amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", nbsp: ' ' };
const codePoint = (ref: string) => (/^#x/i.test(ref) ? parseInt(ref.slice(2), 16) : parseInt(ref.slice(1), 10));
const decodeEntity = (entity: string, ref: string) => {
  if (!ref.startsWith('#')) return ENTITIES[ref.toLowerCase()] ?? entity;
  const code = codePoint(ref);
  return code > 0 && code <= 0x10ffff ? String.fromCodePoint(code) : entity;
};
const textOf = (html: string) =>
  html
    .replace(/<[^>]*>/g, ' ')
    .replace(/&(#x[0-9a-f]+|#[0-9]+|[a-z]+);/gi, decodeEntity)
    .replace(/\s+/g, ' ')
    .trim();
const titleSlotHtml = hasTitleSlot ? await Astro.slots.render('title') : '';
const ariaLabel = textOf(titleSlotHtml) || title || 'Slider';
---

{
  slides && (
    <div role="region" aria-label={ariaLabel} aria-roledescription="carousel" class={classes} {...rest}>
      <div class="container">
        <div class="row">
          <div class="col-xxs-12">
            {hasContentTop && (
              <Fragment>
                <div class="ct-slider__content__top">
                  {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
                </div>{' '}
              </Fragment>
            )}
            <div class="ct-slider__container" data-slider="">
              {hasTitle && (
                <Fragment>
                  {hasTitleSlot ? (
                    <Fragment set:html={titleSlotHtml} />
                  ) : (
                    <Heading theme={theme} content={title} level={2} class="ct-slider__title" />
                  )}{' '}
                </Fragment>
              )}
              <div class="ct-slider__slides" data-slider-panel="">
                <div class="ct-slider__slides__inner" data-slider-rail="" set:html={slides} />
              </div>{' '}
              <div class="ct-slider__controls">
                <div class="ct-slider__controls__inner">
                  <Button
                    theme={theme}
                    text={previousLabel || 'Previous'}
                    type="secondary"
                    icon="left-arrow"
                    iconPlacement="before"
                    class="ct-slider__controls__previous"
                    data-slider-previous=""
                  />{' '}
                  <Button
                    theme={theme}
                    text={nextLabel || 'Next'}
                    type="secondary"
                    icon="right-arrow-2"
                    iconPlacement="after"
                    class="ct-slider__controls__next"
                    data-slider-next=""
                  />
                </div>{' '}
                <Tag
                  theme={theme}
                  content="Slide 1"
                  class="ct-slider__controls__progress-indicator"
                  aria-live="polite"
                  data-slider-progress=""
                />
              </div>
            </div>{' '}
            {hasContentBottom && (
              <div class="ct-slider__content__bottom">
                {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  )
}
