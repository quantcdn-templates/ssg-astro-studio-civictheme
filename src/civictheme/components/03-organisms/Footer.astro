---
/**
 * CivicTheme Footer component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - backgroundImage: Content background inline image URL.
 * - contentTop1 / contentTop2 / contentMiddle1..5 / contentBottom1 /
 *   contentBottom2: Documented as Slots upstream, but every upstream test
 *   passes plain string props — ported as `string` props, rendered with
 *   `set:html` per this project's autoescape convention.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: upstream declares 5 middle slots (`content_middle1`..`5`), not 4 —
 * `content_middle5` spans the full `col-xxs-12` width (the other 4 are
 * `col-m-3` quarters). Ported all 5 for fidelity; each of the 9 slots here
 * gates its own `<div>` individually (unlike `Header`'s top2/top3 pair).
 *
 * Note: `footer.twig:40`'s ROOT `<footer>` gate deliberately omits
 * `content_middle5` from its `is not empty` chain (only `content_top1/2`,
 * `content_middle1..4` and `content_bottom1/2` are listed) — so a Footer
 * given ONLY `contentMiddle5` renders nothing at all, even though the
 * inner `.ct-footer__middle` container's own gate (`footer.twig:70`) DOES
 * include all five. `shouldRender` excludes `contentMiddle5`; `hasMiddle`
 * (used for the inner container) includes it.
 */
interface Props {
  theme?: 'light' | 'dark';
  backgroundImage?: string;
  contentTop1?: string;
  contentTop2?: string;
  contentMiddle1?: string;
  contentMiddle2?: string;
  contentMiddle3?: string;
  contentMiddle4?: string;
  contentMiddle5?: string;
  contentBottom1?: string;
  contentBottom2?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  backgroundImage,
  contentTop1,
  contentTop2,
  contentMiddle1,
  contentMiddle2,
  contentMiddle3,
  contentMiddle4,
  contentMiddle5,
  contentBottom1,
  contentBottom2,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['ct-footer', `ct-theme-${theme}`, className].filter(Boolean).join(' ');

// Slot-vs-string-prop precedence (same convention as `List.astro`): every
// Slot-documented prop from footer.twig's doc header gets a same-named named
// slot. When the slot is present it takes precedence over the string prop,
// and every `{% if %}` gate widens to "string prop OR slot" so a slot-only
// usage still opens the wrapper markup.
const hasContentTop1Slot = Astro.slots.has('contentTop1');
const hasContentTop2Slot = Astro.slots.has('contentTop2');
const hasContentMiddle1Slot = Astro.slots.has('contentMiddle1');
const hasContentMiddle2Slot = Astro.slots.has('contentMiddle2');
const hasContentMiddle3Slot = Astro.slots.has('contentMiddle3');
const hasContentMiddle4Slot = Astro.slots.has('contentMiddle4');
const hasContentMiddle5Slot = Astro.slots.has('contentMiddle5');
const hasContentBottom1Slot = Astro.slots.has('contentBottom1');
const hasContentBottom2Slot = Astro.slots.has('contentBottom2');

const hasContentTop1 = Boolean(contentTop1) || hasContentTop1Slot;
const hasContentTop2 = Boolean(contentTop2) || hasContentTop2Slot;
const hasContentMiddle1 = Boolean(contentMiddle1) || hasContentMiddle1Slot;
const hasContentMiddle2 = Boolean(contentMiddle2) || hasContentMiddle2Slot;
const hasContentMiddle3 = Boolean(contentMiddle3) || hasContentMiddle3Slot;
const hasContentMiddle4 = Boolean(contentMiddle4) || hasContentMiddle4Slot;
const hasContentMiddle5 = Boolean(contentMiddle5) || hasContentMiddle5Slot;
const hasContentBottom1 = Boolean(contentBottom1) || hasContentBottom1Slot;
const hasContentBottom2 = Boolean(contentBottom2) || hasContentBottom2Slot;

const hasTop = hasContentTop1 || hasContentTop2;
const hasMiddle = hasContentMiddle1 || hasContentMiddle2 || hasContentMiddle3 || hasContentMiddle4 || hasContentMiddle5;
const hasBottom = hasContentBottom1 || hasContentBottom2;
// footer.twig:40 — the root gate excludes contentMiddle5 on purpose (see
// the note above); do not fold it into this Boolean.
const shouldRender =
  hasContentTop1 ||
  hasContentTop2 ||
  hasContentMiddle1 ||
  hasContentMiddle2 ||
  hasContentMiddle3 ||
  hasContentMiddle4 ||
  hasContentBottom1 ||
  hasContentBottom2;
---

{
  shouldRender && (
    <footer
      class={classes}
      role="contentinfo"
      data-component-name="ct-footer"
      style={backgroundImage ? `background-image: url('${backgroundImage}')` : undefined}
      {...rest}
    >
      {hasTop && (
        <Fragment>
          <div class="container ct-footer__top">
            <div class="row">
              {hasContentTop1 && (
                <Fragment>
                  <div class="col-xxs-12 col-m-6">
                    <div class="ct-footer__top__content-top1">
                      {hasContentTop1Slot ? <slot name="contentTop1" /> : <Fragment set:html={contentTop1} />}
                    </div>
                  </div>{' '}
                </Fragment>
              )}
              {hasContentTop2 && (
                <div class="col-xxs-12 col-m-6">
                  <div class="ct-footer__top__content-top2">
                    {hasContentTop2Slot ? <slot name="contentTop2" /> : <Fragment set:html={contentTop2} />}
                  </div>
                </div>
              )}
            </div>
          </div>{' '}
        </Fragment>
      )}
      {hasMiddle && (
        <Fragment>
          <div class="container ct-footer__middle">
            <div class="row">
              {hasContentMiddle1 && (
                <Fragment>
                  <div class="col-xxs-12 col-m-3">
                    <div class="ct-footer__middle__content-middle1">
                      {hasContentMiddle1Slot ? <slot name="contentMiddle1" /> : <Fragment set:html={contentMiddle1} />}
                    </div>
                  </div>{' '}
                </Fragment>
              )}
              {hasContentMiddle2 && (
                <Fragment>
                  <div class="col-xxs-12 col-m-3">
                    <div class="ct-footer__middle__content-middle2">
                      {hasContentMiddle2Slot ? <slot name="contentMiddle2" /> : <Fragment set:html={contentMiddle2} />}
                    </div>
                  </div>{' '}
                </Fragment>
              )}
              {hasContentMiddle3 && (
                <Fragment>
                  <div class="col-xxs-12 col-m-3">
                    <div class="ct-footer__middle__content-middle3">
                      {hasContentMiddle3Slot ? <slot name="contentMiddle3" /> : <Fragment set:html={contentMiddle3} />}
                    </div>
                  </div>{' '}
                </Fragment>
              )}
              {hasContentMiddle4 && (
                <Fragment>
                  <div class="col-xxs-12 col-m-3">
                    <div class="ct-footer__middle__content-middle4">
                      {hasContentMiddle4Slot ? <slot name="contentMiddle4" /> : <Fragment set:html={contentMiddle4} />}
                    </div>
                  </div>{' '}
                </Fragment>
              )}
              {hasContentMiddle5 && (
                <div class="col-xxs-12">
                  <div class="ct-footer__middle__content-middle5">
                    {hasContentMiddle5Slot ? <slot name="contentMiddle5" /> : <Fragment set:html={contentMiddle5} />}
                  </div>
                </div>
              )}
            </div>
          </div>{' '}
        </Fragment>
      )}
      {hasBottom && (
        <div class="container ct-footer__bottom">
          <div class="row">
            {hasContentBottom1 && (
              <Fragment>
                <div class="col-xxs-12 col-m-7">
                  <div class="ct-footer__bottom__content-bottom1">
                    {hasContentBottom1Slot ? <slot name="contentBottom1" /> : <Fragment set:html={contentBottom1} />}
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {hasContentBottom2 && (
              <div class="col-xxs-12 col-m-5">
                <div class="ct-footer__bottom__content-bottom2">
                  {hasContentBottom2Slot ? <slot name="contentBottom2" /> : <Fragment set:html={contentBottom2} />}
                </div>
              </div>
            )}
          </div>
        </div>
      )}
    </footer>
  )
}
