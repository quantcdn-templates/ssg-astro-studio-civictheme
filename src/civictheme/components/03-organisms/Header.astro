---
/**
 * CivicTheme Header component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - contentTop1 / contentTop2 / contentTop3 / contentMiddle1 /
 *   contentMiddle2 / contentMiddle3 / contentBottom1: Documented as Slots
 *   upstream, but every upstream test passes plain string props — ported
 *   as `string` props, rendered with `set:html` per this project's
 *   autoescape convention.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: `content_top2_block`/`content_top3_block` have no individual
 * `{% if %}` guard of their own — both cols always render, unconditionally,
 * whenever EITHER `content_top2` or `content_top3` is non-empty (only the
 * shared outer `.container` is gated on the pair). This differs from
 * `content_middle2_block`/`content_middle3_block`, which upstream DOES gate
 * individually. Reproduced faithfully: `hasTop2Or3` gates the whole
 * container (both cols unconditional inside it), while `contentMiddle2`/
 * `contentMiddle3` each gate their own col independently.
 */
interface Props {
  theme?: 'light' | 'dark';
  contentTop1?: string;
  contentTop2?: string;
  contentTop3?: string;
  contentMiddle1?: string;
  contentMiddle2?: string;
  contentMiddle3?: string;
  contentBottom1?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  contentTop1,
  contentTop2,
  contentTop3,
  contentMiddle1,
  contentMiddle2,
  contentMiddle3,
  contentBottom1,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['ct-header', `ct-theme-${theme}`, className].filter(Boolean).join(' ');

// Slot-vs-string-prop precedence (same convention as `List.astro`): every
// Slot-documented prop from header.twig's doc header gets a same-named
// named slot. When the slot is present it takes precedence over the string
// prop, and every `{% if %}` gate widens to "string prop OR slot" so a
// slot-only usage still opens the wrapper markup.
const hasTop1Slot = Astro.slots.has('contentTop1');
const hasTop2Slot = Astro.slots.has('contentTop2');
const hasTop3Slot = Astro.slots.has('contentTop3');
const hasMiddle1Slot = Astro.slots.has('contentMiddle1');
const hasMiddle2Slot = Astro.slots.has('contentMiddle2');
const hasMiddle3Slot = Astro.slots.has('contentMiddle3');
const hasBottom1Slot = Astro.slots.has('contentBottom1');

const hasTop1 = Boolean(contentTop1) || hasTop1Slot;
const hasTop2 = Boolean(contentTop2) || hasTop2Slot;
const hasTop3 = Boolean(contentTop3) || hasTop3Slot;
const hasMiddle1 = Boolean(contentMiddle1) || hasMiddle1Slot;
const hasMiddle2 = Boolean(contentMiddle2) || hasMiddle2Slot;
const hasMiddle3 = Boolean(contentMiddle3) || hasMiddle3Slot;
const hasBottom1 = Boolean(contentBottom1) || hasBottom1Slot;

const hasTop = hasTop1 || hasTop2 || hasTop3;
const hasTop2Or3 = hasTop2 || hasTop3;
const hasMiddle = hasMiddle1 || hasMiddle2 || hasMiddle3;
const hasMiddle2Or3 = hasMiddle2 || hasMiddle3;
const shouldRender = hasTop || hasMiddle || hasBottom1;
---

{
  shouldRender && (
    <header class={classes} role="banner" {...rest}>
      {hasTop && (
        <Fragment>
          <div class="ct-header__top hide-xxs show-m">
            {hasTop1 && (
              <Fragment>
                <div class="container">
                  <div class="row">
                    <div class="col-xxs-12">
                      <div class="ct-header__content-top1">
                        {hasTop1Slot ? <slot name="contentTop1" /> : <Fragment set:html={contentTop1} />}
                      </div>
                    </div>
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {hasTop2Or3 && (
              <div class="container">
                <div class="row">
                  <div class="col-xxs-12 col-m-4">
                    <div class="ct-header__content-top2">
                      {hasTop2Slot ? <slot name="contentTop2" /> : <Fragment set:html={contentTop2} />}
                    </div>
                  </div>{' '}
                  <div class="col-xxs-12 col-m-8">
                    <div class="ct-header__content-top3">
                      {hasTop3Slot ? <slot name="contentTop3" /> : <Fragment set:html={contentTop3} />}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>{' '}
        </Fragment>
      )}
      {hasMiddle && (
        <Fragment>
          <div class="ct-header__middle">
            {hasMiddle1 && (
              <Fragment>
                <div class="container">
                  <div class="row">
                    <div class="col-xxs-12">
                      <div class="ct-header__content-middle1">
                        {hasMiddle1Slot ? <slot name="contentMiddle1" /> : <Fragment set:html={contentMiddle1} />}
                      </div>
                    </div>
                  </div>
                </div>{' '}
              </Fragment>
            )}
            {hasMiddle2Or3 && (
              <div class="container">
                <div class="row row--no-wrap">
                  {hasMiddle2 && (
                    <Fragment>
                      <div class="col col--no-grow">
                        <div class="ct-header__content-middle2">
                          {hasMiddle2Slot ? <slot name="contentMiddle2" /> : <Fragment set:html={contentMiddle2} />}
                        </div>
                      </div>{' '}
                    </Fragment>
                  )}
                  {hasMiddle3 && (
                    <div class="col">
                      <div class="ct-header__content-middle3">
                        {hasMiddle3Slot ? <slot name="contentMiddle3" /> : <Fragment set:html={contentMiddle3} />}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>{' '}
        </Fragment>
      )}
      {hasBottom1 && (
        <div class="ct-header__bottom">
          <div class="container">
            <div class="row">
              <div class="col-xxs-12">
                <div class="ct-header__content-bottom1">
                  {hasBottom1Slot ? <slot name="contentBottom1" /> : <Fragment set:html={contentBottom1} />}
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </header>
  )
}
