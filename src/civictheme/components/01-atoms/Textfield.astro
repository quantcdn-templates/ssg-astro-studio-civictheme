---
/**
 * CivicTheme Textfield component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - name: DOM name (required).
 * - id: DOM ID attribute.
 * - value: The textfield value.
 * - placeholder: Placeholder text.
 * - isInvalid: Whether the textfield is invalid.
 * - isDisabled: Whether the textfield is disabled.
 * - isRequired: Whether the textfield is required.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <input>.
 */
interface Props {
  theme?: 'light' | 'dark';
  name?: string;
  id?: string;
  value?: string;
  placeholder?: string;
  isInvalid?: boolean;
  isDisabled?: boolean;
  isRequired?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  name,
  id,
  value,
  placeholder,
  isInvalid,
  isDisabled,
  isRequired,
  class: className = '',
  ...rest
} = Astro.props;

const themeClass = `ct-theme-${theme}`;
const classes = ['ct-textfield', themeClass, isInvalid && 'ct-textfield--is-invalid', className]
  .filter(Boolean)
  .join(' ');
---

{
  name && (
    <input
      type="text"
      class={classes}
      name={name}
      value={value || undefined}
      id={id || undefined}
      disabled={isDisabled ? 'disabled' : undefined}
      required={isRequired ? 'required' : undefined}
      aria-invalid={isInvalid ? 'true' : undefined}
      placeholder={placeholder || undefined}
      {...rest}
    />
  )
}
