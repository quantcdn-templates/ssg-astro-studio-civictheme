---
/**
 * CivicTheme Video component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - title: Video title.
 * - hasControls: Whether the video should have controls.
 * - sources: Video sources ({ url, type }).
 * - poster: Video poster URL.
 * - width: Video width.
 * - height: Video height.
 * - fallbackText: Message for browsers not supporting HTML5 video.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <video>.
 */
interface Props {
  theme?: 'light' | 'dark';
  title?: string;
  hasControls?: boolean;
  sources?: Array<{ url?: string; type?: string }>;
  poster?: string;
  width?: string;
  height?: string;
  fallbackText?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  title,
  hasControls,
  sources = [],
  poster,
  width,
  height,
  fallbackText: fallbackTextProp,
  class: className = '',
  ...rest
} = Astro.props;

const themeClass = `ct-theme-${theme}`;
const classes = ['ct-video', themeClass, className].filter(Boolean).join(' ');
const fallbackText = fallbackTextProp || "Your browser doesn't support HTML5 video.";
---

{
  sources.length > 0 && (
    <video
      class={classes}
      title={title || undefined}
      controls={hasControls ? 'controls' : undefined}
      poster={poster || undefined}
      width={width || undefined}
      height={height || undefined}
      {...rest}
    >
      {sources.map((source, i) => (
        <Fragment>
          {i > 0 && ' '}
          <source src={source.url} type={source.type} />
        </Fragment>
      ))}{' '}
      {fallbackText}
    </video>
  )
}
