---
/**
 * CivicTheme Heading component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - content: Heading content.
 * - level: Heading level (1-6). Defaults to 2.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
interface Props {
  theme?: 'light' | 'dark';
  content?: string;
  level?: string | number;
  class?: string;
  [key: string]: unknown;
}

const { theme = 'light', content, level: levelProp, class: className = '', ...rest } = Astro.props;

const classes = ['ct-heading', `ct-theme-${theme}`, className].filter(Boolean).join(' ');
// heading.twig: `{% set level = level|default('2') %}` — Twig's `default`
// filter (like this) falls back on ANY falsy value, not just an omitted
// one, so an explicit `''` or `0` must also resolve to level 2, unlike a
// plain destructuring default (`level = 2`), which only applies when the
// prop is `undefined`.
const level = levelProp || 2;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
---

{
  content && (
    <Tag class={classes} {...rest}>
      {content}
    </Tag>
  )
}
