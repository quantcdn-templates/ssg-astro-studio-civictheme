---
/**
 * CivicTheme Tag component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - type: Tag type (primary, secondary, tertiary).
 * - content: Tag content.
 * - icon: Icon name.
 * - iconPlacement: Icon position (before, after).
 * - url: Optional URL to convert to a link.
 * - isNewWindow: Whether to open in a new window (only if URL is provided).
 * - isExternal: Whether the link is external.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
import Icon from '@civictheme/base/Icon.astro';

interface Props {
  theme?: 'light' | 'dark';
  type?: 'primary' | 'secondary' | 'tertiary';
  content?: string;
  icon?: string | null;
  iconPlacement?: 'before' | 'after';
  url?: string;
  isNewWindow?: boolean | null;
  isExternal?: boolean | null;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  type: typeProp,
  content,
  icon,
  iconPlacement: iconPlacementProp,
  url,
  isNewWindow,
  isExternal,
  class: className = '',
  ...rest
} = Astro.props;

const type = (['primary', 'secondary', 'tertiary'] as const).includes(typeProp as any) ? typeProp! : 'primary';
const iconPlacement = (['before', 'after'] as const).includes(iconPlacementProp as any) ? iconPlacementProp! : 'after';

const themeClass = `ct-theme-${theme}`;
const classes = [
  'ct-tag',
  themeClass,
  `ct-tag--${type}`,
  icon && 'ct-tag--with-icon',
  icon && `ct-tag--icon-${iconPlacement}`,
  isExternal && 'ct-tag--external',
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = url ? 'a' : 'span';
const hasContent = Boolean(content?.trim());
---

{
  hasContent && (
    <Tag
      class={classes}
      href={url || undefined}
      title={url ? content : undefined}
      target={url && isNewWindow ? '_blank' : undefined}
      aria-label={url && isNewWindow ? 'Opens in a new tab' : undefined}
      {...rest}
    >
      {icon && iconPlacement === 'before' && (
        <Fragment>
          <Icon symbol={icon} class="ct-tag__icon" />{' '}
        </Fragment>
      )}
      {content}
      {/* icon_markup is captured via an untrimmed `{% set icon_markup %}…{% endset %}`
          block, so it carries BOTH a leading and a trailing newline from the SVG
          asset/template source — the 'before' branch above already accounts for the
          trailing side; this accounts for the leading side on the 'after' (default)
          placement, between `content` and the icon. */}
      {icon && iconPlacement === 'after' && (
        <Fragment>
          {' '}
          <Icon symbol={icon} class="ct-tag__icon" />
        </Fragment>
      )}
      {/* is_new_window_content/is_external_content are captured via an untrimmed
          Twig `{% set %}...{% endset %}` block whose own leading newline+indent
          becomes part of the printed value — a real leading space, not incidental. */}
      {isNewWindow && (
        <Fragment>
          {' '}
          <span class="ct-visually-hidden">(Opens in a new tab/window)</span>
        </Fragment>
      )}
      {isExternal && (
        <Fragment>
          {' '}
          <Icon symbol="upper-right-arrow" />
        </Fragment>
      )}
    </Tag>
  )
}
