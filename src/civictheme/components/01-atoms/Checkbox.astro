---
/**
 * CivicTheme Checkbox component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - name: DOM name (required).
 * - id: DOM id (required).
 * - value: DOM value.
 * - label: Label content.
 * - isChecked: Whether the checkbox is checked.
 * - isRequired: Whether the checkbox is required.
 * - isInvalid: Whether the checkbox is invalid.
 * - isDisabled: Whether the checkbox is disabled.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <input>.
 *
 * Note: the checkbox's label uses the ported `Label` atom, passing the same
 * props upstream's `checkbox.twig` passes to `@atoms/label/label.twig`
 * (`theme`, `content` = `label`, `for` = `id`, `size: 'small'`,
 * `modifier_class: 'ct-checkbox__label'`).
 */
import Label from '@civictheme/atoms/Label.astro';

interface Props {
  theme?: 'light' | 'dark';
  name?: string;
  id?: string;
  value?: string;
  label?: string;
  isChecked?: boolean;
  isRequired?: boolean;
  isInvalid?: boolean;
  isDisabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  name,
  id,
  value,
  label,
  isChecked,
  isRequired,
  isInvalid,
  isDisabled,
  class: className = '',
  ...rest
} = Astro.props;

const themeClass = `ct-theme-${theme}`;
const classes = ['ct-checkbox', themeClass, isInvalid && 'ct-checkbox--is-invalid', className]
  .filter(Boolean)
  .join(' ');
---

{
  name && id && (
    <Fragment>
      <input
        type="checkbox"
        class={classes}
        name={name}
        value={value ?? ''}
        id={id}
        checked={isChecked || undefined}
        required={isRequired || undefined}
        disabled={isDisabled || undefined}
        aria-invalid={isInvalid ? 'true' : undefined}
        {...rest}
      />
      {label && (
        <Fragment>
          {' '}
          <Label theme={theme} content={label} for={id} size="small" class="ct-checkbox__label" />
        </Fragment>
      )}
    </Fragment>
  )
}
