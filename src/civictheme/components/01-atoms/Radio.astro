---
/**
 * CivicTheme Radio component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - name: DOM name (required).
 * - id: DOM id (required).
 * - value: DOM value.
 * - label: Label content.
 * - isChecked: Whether the radio is checked.
 * - isRequired: Whether the radio is required.
 * - isInvalid: Whether the radio is invalid.
 * - isDisabled: Whether the radio is disabled.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <input>.
 */
import Label from '@civictheme/atoms/Label.astro';

interface Props {
  theme?: 'light' | 'dark';
  name?: string;
  id?: string;
  value?: string | boolean;
  label?: string;
  isChecked?: boolean;
  isRequired?: boolean;
  isInvalid?: boolean;
  isDisabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  name,
  id,
  value,
  label,
  isChecked,
  isRequired,
  isInvalid,
  isDisabled,
  class: className = '',
  ...rest
} = Astro.props;

const themeClass = `ct-theme-${theme}`;
const classes = ['ct-radio', themeClass, isInvalid && 'ct-radio--is-invalid', className].filter(Boolean).join(' ');
---

{
  name && id && (
    <Fragment>
      <input
        type="radio"
        class={classes}
        name={name}
        value={(value ?? '') as any}
        id={id}
        checked={isChecked ? 'checked' : undefined}
        required={isRequired ? 'required' : undefined}
        disabled={isDisabled ? 'disabled' : undefined}
        aria-invalid={isInvalid ? 'true' : undefined}
        {...rest}
      />
      {label && (
        <Fragment>
          {' '}
          <Label theme={theme} content={label} for={id} size="small" class="ct-radio__label" />
        </Fragment>
      )}
    </Fragment>
  )
}
