---
import Link from '@civictheme/atoms/Link.astro';

interface Props {
  theme?: 'light' | 'dark';
  trigger?: { text?: string; url?: string; isNewWindow?: boolean; isExternal?: boolean };
  group?: string;
  class?: string;
  [key: string]: unknown;
}
const { theme = 'light', trigger, group, class: className = '', ...rest } = Astro.props;
---
<!-- TWIG:
{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set modifier_class = '%s %s'|format(theme_class, modifier_class|default('')) %}

{% if content is not empty %}
  <div class="ct-popover {{ modifier_class -}}" data-collapsible data-collapsible-collapsed data-collapsible-group="{{ group|default('') }}" data-collapsible-duration="250" {% if attributes is defined and attributes is not null %}{{- attributes -}}{% endif %}>
    {% include '@atoms/link/link.twig' with {
      theme: theme,
      text: trigger.text,
      url: trigger.url is defined ? trigger.url : null,
      is_new_window: trigger.is_new_window,
      modifier_class: 'ct-popover__link',
      attributes: create_attribute({'data-collapsible-trigger': '', tabindex: '0'}),
    } only %}

    <div class="ct-popover__content" data-collapsible-panel>
      <div class="ct-popover__content__inner">

        {% block content_top_block %}
          {% if content_top is not empty %}
            <div class="ct-popover__content-top">
              {{- content_top -}}
            </div>
          {% endif %}
        {% endblock %}

        {% block content_block %}
          {{- content -}}
        {% endblock %}

        {% block content_bottom_block %}
          {% if content_bottom is not empty %}
            <div class="ct-popover__content-bottom">
              {{- content_bottom -}}
            </div>
          {% endif %}
        {% endblock %}
      </div>
    </div>
  </div>
{% endif %}
-->
