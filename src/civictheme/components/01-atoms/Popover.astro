---
/**
 * CivicTheme Popover component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - trigger: Popover trigger link object ({ text, url, isNewWindow }).
 * - content / contentTop / contentBottom: Documented as Slots upstream —
 *   still typed as `string` props rendered with `set:html`, but each also
 *   has a same-named Astro slot that TAKES PRECEDENCE over the string
 *   prop when present (Task 14c). Every `{% if %}` gate (including the
 *   root) widens to `Boolean(prop) || Astro.slots.has('prop')`.
 *   `contentTop`/`contentBottom` are not exercised by any upstream
 *   snapshot.
 * - group: Group name for controlling multiple popovers together.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <div>.
 */
import Link from '@civictheme/atoms/Link.astro';

interface Props {
  theme?: 'light' | 'dark';
  trigger?: { text?: string; url?: string; isNewWindow?: boolean; isExternal?: boolean };
  content?: string;
  contentTop?: string;
  contentBottom?: string;
  group?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  trigger = {},
  content,
  contentTop,
  contentBottom,
  group = '',
  class: className = '',
  ...rest
} = Astro.props;

const themeClass = `ct-theme-${theme}`;
const classes = ['ct-popover', themeClass, className].filter(Boolean).join(' ');

const hasContentSlot = Astro.slots.has('content');
const hasContentTopSlot = Astro.slots.has('contentTop');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasContent = Boolean(content) || hasContentSlot;
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;
---

{
  hasContent && (
    <div
      class={classes}
      data-collapsible=""
      data-collapsible-collapsed=""
      data-collapsible-group={group}
      data-collapsible-duration="250"
      {...rest}
    >
      <Link
        theme={theme}
        text={trigger.text}
        url={trigger.url}
        isNewWindow={trigger.isNewWindow}
        class="ct-popover__link"
        data-collapsible-trigger=""
        tabindex="0"
      />{' '}
      <div class="ct-popover__content" data-collapsible-panel="">
        <div class="ct-popover__content__inner">
          {hasContentTop && (
            <div class="ct-popover__content-top">
              {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
            </div>
          )}
          {hasContentSlot ? <slot name="content" /> : <Fragment set:html={content} />}
          {hasContentBottom && (
            <div class="ct-popover__content-bottom">
              {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
