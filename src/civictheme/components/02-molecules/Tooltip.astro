---
/**
 * CivicTheme Tooltip component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - position: Tooltip position ('auto', 'auto-start', 'auto-end', 'top',
 *   'top-start', 'top-end', 'bottom', 'bottom-start', 'bottom-end',
 *   'right', 'right-start', 'right-end', 'left', 'left-start', 'left-end').
 * - icon: Symbol to use in the button. Defaults to 'information-mark'.
 * - iconSize: Icon size. Defaults to 'large'.
 * - title / content: Documented as Slots upstream, but every upstream
 *   test passes plain string props — ported as `string` props, `content`
 *   rendered with `set:html` per this project's autoescape convention
 *   (`title` is used only as a plain attribute value, matching upstream's
 *   `aria-label`/`title` attribute usage — not printed as markup).
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
import Icon from '@civictheme/base/Icon.astro';
import Button from '@civictheme/atoms/Button.astro';

interface Props {
  theme?: 'light' | 'dark';
  position?: string;
  icon?: string;
  iconSize?: string;
  title?: string;
  content?: string;
  class?: string;
  [key: string]: unknown;
}

const { theme = 'light', position, icon, iconSize, title, content, class: className = '', ...rest } = Astro.props;

const classes = ['ct-tooltip', `ct-theme-${theme}`, className].filter(Boolean).join(' ');
---

{
  content && (
    <div class={classes} data-component-name="tooltip" {...rest}>
      <button
        class="ct-tooltip__button"
        aria-label={title || undefined}
        title={title || undefined}
        data-tooltip-button
        data-tooltip-position={position ?? ''}
      >
        <Icon symbol={icon || 'information-mark'} size={iconSize || 'large'} />
      </button>{' '}
      <div class="ct-tooltip__description" data-tooltip-content>
        <div class="ct-tooltip__description__inner" set:html={content} />{' '}
        <div data-tooltip-close>
          <Button type="tertiary" kind="button" icon="cancel" size="regular" class="ct-tooltip__close-button" />
        </div>{' '}
        <div class="ct-tooltip__arrow" data-tooltip-arrow />
      </div>
    </div>
  )
}
