---
import Button from '@civictheme/atoms/Button.astro';
import Icon from '@civictheme/base/Icon.astro';

interface Props {
  theme?: 'light' | 'dark';
  position?: string;
  icon?: string;
  iconSize?: string;
  class?: string;
  [key: string]: unknown;
}
const { theme = 'light', position, icon, iconSize, class: className = '', ...rest } = Astro.props;
---
<!-- TWIG:
{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set modifier_class = '%s %s'|format(theme_class, modifier_class|default('')) %}

{% if content %}
  <div class="ct-tooltip {{ modifier_class -}}" data-component-name="tooltip" {% if attributes is defined and attributes is not null %}{{- attributes -}}{% endif %}>
    <button class="ct-tooltip__button" {% if title %}aria-label="{{ title }}" title="{{ title }}"{% endif %} data-tooltip-button data-tooltip-position="{{ position }}">
      {%- include '@base/icon/icon.twig' with {
        symbol: icon|default('information-mark'),
        size: icon_size|default('large'),
      } only -%}
    </button>

    <div class="ct-tooltip__description" data-tooltip-content>
      <div class="ct-tooltip__description__inner">
        {{- content -}}
      </div>
      <div data-tooltip-close>
        {%- include '@atoms/button/button.twig' with {
          type: 'tertiary',
          kind: 'button',
          icon: 'cancel',
          size: 'regular',
          modifier_class: 'ct-tooltip__close-button',
        } only -%}
      </div>

      <div class="ct-tooltip__arrow" data-tooltip-arrow></div>
    </div>
  </div>
{% endif %}
-->
