---
interface Props {
  theme?: 'light' | 'dark';
  isContained?: boolean;
  verticalSpacing?: string;
  withBackground?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { theme = 'light', isContained, verticalSpacing, withBackground, class: className = '', ...rest } = Astro.props;
---
<!-- TWIG:
{% set with_background_class = with_background ? 'ct-basic-content--with-background' : '' %}
{% set vertical_spacing_class = vertical_spacing in ['top', 'bottom', 'both'] ? 'ct-vertical-spacing-inset--%s'|format(vertical_spacing) : '' %}
{% set theme = theme|default('light') %}
{% set theme = theme in ['light', 'dark'] ? theme : 'light' %}
{% set theme_class = 'ct-theme-%s'|format(theme) %}
{% set modifier_class = '%s %s %s %s'|format(theme_class, vertical_spacing_class, with_background_class, modifier_class|default('')) %}

{% set is_contained = is_contained is not same as(false) %}

{% if content is not empty %}
  <div class="ct-basic-content {{ modifier_class -}}" {% if attributes is defined and attributes is not null %}{{- attributes -}}{% endif %}>
    {% if is_contained %}
    <div class="container">
      <div class="row">
        <div class="col-xxs-12">
          {% endif %}
          {{- content -}}
          {% if is_contained %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
{% endif %}
-->
