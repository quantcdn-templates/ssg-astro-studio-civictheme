---
/**
 * CivicTheme Basic Content component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - isContained: Whether to wrap the content in a container. Defaults to
 *   true (`is_contained is not same as(false)` — anything but the literal
 *   boolean `false` counts as contained).
 * - verticalSpacing: Vertical spacing position (top, bottom, both).
 * - withBackground: Whether to display with a background.
 * - content: HTML content. Documented as a Slot upstream — still typed as
 *   a `string` prop rendered with `set:html`, but also has a same-named
 *   Astro slot that TAKES PRECEDENCE over the string prop when present
 *   (Task 14c). The root render gate widens to
 *   `Boolean(content) || Astro.slots.has('content')`.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
interface Props {
  theme?: 'light' | 'dark';
  isContained?: boolean;
  verticalSpacing?: 'top' | 'bottom' | 'both';
  withBackground?: boolean;
  content?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme: themeProp,
  isContained,
  verticalSpacing,
  withBackground,
  content,
  class: className = '',
  ...rest
} = Astro.props;

const theme = themeProp === 'dark' ? 'dark' : 'light';
const verticalSpacingClass = (['top', 'bottom', 'both'] as const).includes(verticalSpacing as any)
  ? `ct-vertical-spacing-inset--${verticalSpacing}`
  : '';
const isContainedResolved = isContained !== false;

const classes = [
  'ct-basic-content',
  `ct-theme-${theme}`,
  verticalSpacingClass,
  withBackground && 'ct-basic-content--with-background',
  className,
]
  .filter(Boolean)
  .join(' ');

const hasContentSlot = Astro.slots.has('content');
const hasContent = Boolean(content) || hasContentSlot;
---

{
  hasContent && (
    <div class={classes} {...rest}>
      {isContainedResolved ? (
        <div class="container">
          <div class="row">
            <div class="col-xxs-12">{hasContentSlot ? <slot name="content" /> : <Fragment set:html={content} />}</div>
          </div>
        </div>
      ) : hasContentSlot ? (
        <slot name="content" />
      ) : (
        <Fragment set:html={content} />
      )}
    </div>
  )
}
