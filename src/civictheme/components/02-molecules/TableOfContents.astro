---
interface Props {
  theme?: 'light' | 'dark';
  title?: string;
  position?: string;
  anchorSelector?: string;
  scopeSelector?: string;
  class?: string;
  [key: string]: unknown;
}
const { theme = 'light', title, position, anchorSelector, scopeSelector, class: className = '', ...rest } = Astro.props;
---
