---
/**
 * CivicTheme Table of Contents component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - title: Link title.
 * - position: TOC position ('before', 'after', 'prepend', 'append').
 * - anchorSelector: CSS selector for headings to include in TOC (e.g.
 *   'h2, h3').
 * - scopeSelector: CSS selector for the content area to generate TOC from.
 * - links: Table of contents links: Array<{ title, url }>. When given, a
 *   static list is rendered (matching upstream's `links is not empty`
 *   branch); otherwise (when `scopeSelector` is given) the behaviour-hook
 *   markup is rendered, and CivicTheme's `table-of-contents.js` builds the
 *   link list client-side from the DOM.
 * - content: Content HTML (only used in the automatic/behaviour-hook
 *   branch, i.e. when `links` is absent) — documented as a Slot upstream,
 *   ported as a `string` prop rendered with `set:html` per this project's
 *   autoescape convention. Also has a same-named Astro slot that TAKES
 *   PRECEDENCE over the string prop when present (Task 14c).
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the static-list
 *   branch's root element (matching upstream's `attributes` usage there;
 *   the automatic branch's root never prints `attributes` upstream).
 *
 * Note: `table-of-contents.twig` has no upstream `.test.js` /
 * `__snapshots__` at all (only `.scss`/`.stories.*` files exist in
 * `.upstream/uikit/packages/twig/components/02-molecules/table-of-
 * contents`) — smoke test per the task brief's rule for components with
 * no upstream test, matching `InlineFilter`'s precedent. Behaviour-hook
 * attribute names (`data-table-of-contents-*`) are copied verbatim from
 * the Twig; confirmed against `src/civictheme/js/behaviours/table-of-
 * contents.js`, which reads exactly these names off the element it
 * initialises.
 *
 * Note: `table-of-contents.twig` prints all five `data-table-of-contents-*`
 * attributes unconditionally (an unset value prints as an empty string,
 * never omits the attribute) — each is coerced with `?? ''` here to match,
 * since Astro omits an attribute whose value is `undefined`. This matters
 * for real behaviour, not just markup fidelity: `table-of-contents.js`
 * selects on `[data-table-of-contents-position]` existing at all, so an
 * omitted `position` attribute would mean the behaviour never initialises.
 */
interface TocLink {
  title?: string;
  url?: string;
}

interface Props {
  theme?: 'light' | 'dark';
  title?: string;
  position?: 'before' | 'after' | 'prepend' | 'append';
  anchorSelector?: string;
  scopeSelector?: string;
  links?: TocLink[];
  content?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  title,
  position,
  anchorSelector,
  scopeSelector,
  links,
  content,
  class: className = '',
  ...rest
} = Astro.props;

const hasLinks = Boolean(links && links.length > 0);
const shouldRender = hasLinks || Boolean(scopeSelector);
const classes = [
  'ct-table-of-contents',
  `ct-theme-${theme}`,
  `ct-table-of-contents--position-${position || 'before'}`,
  className,
]
  .filter(Boolean)
  .join(' ');

const hasContentSlot = Astro.slots.has('content');
---

{
  shouldRender && (
    <div class="container">
      <div class="row">
        <div class="col-xxs-12">
          {hasLinks ? (
            <div class={classes} {...rest}>
              {title && <h2 class="ct-table-of-contents__title">{title}</h2>}
              <ul class="ct-table-of-contents__links">
                {(links ?? []).map((link, i) => (
                  <Fragment>
                    {i > 0 && ' '}
                    <li class="ct-table-of-contents__link-item">
                      <a class="ct-table-of-contents__link" href={link.url}>
                        {link.title}
                      </a>
                    </li>
                  </Fragment>
                ))}
              </ul>
            </div>
          ) : (
            <div
              data-table-of-contents-theme={theme ?? ''}
              data-table-of-contents-title={title ?? ''}
              data-table-of-contents-anchor-selector={anchorSelector ?? ''}
              data-table-of-contents-anchor-scope-selector={scopeSelector ?? ''}
              data-table-of-contents-position={position ?? ''}
            >
              {hasContentSlot ? <slot name="content" /> : <Fragment set:html={content} />}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
