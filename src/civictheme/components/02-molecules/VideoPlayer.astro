---
/**
 * CivicTheme Video Player component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - title: Button title (also used as the iframe's `title` attribute for
 *   the oEmbed branch).
 * - poster: Optional video poster URL.
 * - width / height: Video dimensions.
 * - sources: Video sources: Array<{ url, type }>.
 * - embeddedSource: Iframe URL.
 * - rawSource: HTML of a raw embedded video player — documented as
 *   `[string]` (not HTML-bearing) upstream, but every upstream `.snap`
 *   fixture is generated with Twig's `autoescape` off (see PORTING.md), so
 *   it is rendered with `set:html` per this project's autoescape
 *   convention.
 * - transcriptLink: Video transcript link: { text, title, url,
 *   isNewWindow, isExternal }.
 * - transcriptContent: HTML of transcript content, routed through
 *   `BasicContent` exactly like upstream's
 *   `@molecules/basic-content/basic-content.twig` include.
 * - transcriptExpandText / transcriptCollapseText: Transcript collapsible
 *   trigger text.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes. Not spread onto the root element —
 *   matching upstream's `video-player.twig`, whose root `<div>` never
 *   prints `attributes` (it is only ever used, mutated, for the iframe
 *   branch).
 */
import Video from '@civictheme/atoms/Video.astro';
import Iframe from '@civictheme/atoms/Iframe.astro';
import Link from '@civictheme/atoms/Link.astro';
import Button from '@civictheme/atoms/Button.astro';
import BasicContent from '@civictheme/molecules/BasicContent.astro';

interface TranscriptLink {
  text?: string;
  title?: string;
  url?: string;
  isNewWindow?: boolean;
  isExternal?: boolean;
}

interface Props {
  theme?: 'light' | 'dark';
  title?: string;
  poster?: string;
  width?: string;
  height?: string;
  sources?: Array<{ url?: string; type?: string }>;
  embeddedSource?: string;
  rawSource?: string;
  transcriptLink?: TranscriptLink | null;
  transcriptContent?: string | null;
  transcriptExpandText?: string;
  transcriptCollapseText?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  title,
  poster,
  width,
  height,
  sources,
  embeddedSource,
  rawSource,
  transcriptLink,
  transcriptContent,
  transcriptExpandText,
  transcriptCollapseText,
  class: className = '',
} = Astro.props;

const hasSources = Boolean(sources && sources.length > 0);
const hasEmbedded = Boolean(embeddedSource);
const hasContent = hasSources || hasEmbedded || rawSource !== undefined;
const classes = ['ct-video-player', `ct-theme-${theme}`, className].filter(Boolean).join(' ');
const hasTranscriptLink = Boolean(transcriptLink?.url);
const hasTranscriptContent = Boolean(transcriptContent);
const hasTranscriptBlock = hasTranscriptLink || hasTranscriptContent;
---

{
  hasContent && (
    <div class={classes}>
      <div class="ct-video-player__wrapper">
        {hasSources ? (
          <Video theme={theme} sources={sources} poster={poster} width={width} height={height} hasControls />
        ) : hasEmbedded ? (
          <Iframe
            url={embeddedSource}
            width={width as any}
            height={height as any}
            allowfullscreen
            data-chromatic="ignore"
            title={title || undefined}
          />
        ) : (
          <Fragment set:html={rawSource} />
        )}
      </div>
      {hasTranscriptBlock && (
        <Fragment>
          {' '}
          <div class="ct-video-player__transcript-block">
            {hasTranscriptLink && (
              <div class="ct-video-player__links">
                <div class="ct-video-player__links-transcript">
                  <Link
                    theme={theme}
                    text={transcriptLink?.text}
                    title={transcriptLink?.title}
                    url={transcriptLink?.url}
                    isNewWindow={transcriptLink?.isNewWindow}
                    isExternal={transcriptLink?.isExternal}
                    icon="eye"
                    iconPlacement="before"
                  />
                </div>
              </div>
            )}
            {hasTranscriptContent && (
              <div
                class="ct-video-player__transcript"
                data-collapsible
                data-collapsible-collapsed
                data-collapsible-duration="250"
              >
                <Button
                  theme={theme}
                  type="tertiary"
                  text={`<span class="ct-video-player__transcript-trigger-expand">${
                    transcriptExpandText || 'Show transcript'
                  }</span><span class="ct-video-player__transcript-trigger-collapse">${
                    transcriptCollapseText || 'Hide transcript'
                  }</span>`}
                  data-collapsible-trigger=""
                  class="ct-video-player__transcript-toggle"
                />
                <div class="ct-video-player__transcript-panel" data-collapsible-panel>
                  <div class="ct-video-player__transcript-panel-inner">
                    <BasicContent theme={theme} content={transcriptContent ?? undefined} />
                  </div>
                </div>
              </div>
            )}
          </div>
        </Fragment>
      )}
    </div>
  )
}
