---
/**
 * CivicTheme Single Filter component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - isMultiple: Whether to allow selection of multiple filter values.
 * - items: Filter links: Array<{ text, isSelected, name, ...rest }> — any
 *   extra keys are spread onto the underlying `Chip` input as attributes,
 *   matching `item.attributes` in the Twig.
 * - formAttributes: Form attributes (if absent, no `<form>` wraps the
 *   filters/actions row at all — matching `form_attributes is defined`).
 * - formHiddenFields: Form hidden fields (HTML-bearing).
 * - contentTop / contentBottom / title / submitText / resetText:
 *   Documented as Slots upstream, but every upstream test passes plain
 *   string props — ported as `string` props, rendered with `set:html`
 *   per this project's autoescape convention (`title`/`submitText`/
 *   `resetText` are passed straight through to `Button`/plain text, since
 *   that is how upstream uses them too).
 * - `contentTop`/`contentBottom`/`title` also now have a same-named Astro
 *   slot that TAKES PRECEDENCE over the string prop when present (Task
 *   14c); their wrapper `{% if %}` gates widen to
 *   `Boolean(prop) || Astro.slots.has('prop')`. `formHiddenFields` also
 *   gets a slot the same way (it is HTML-bearing, rendered bare with
 *   `set:html`, no wrapper of its own to widen).
 * - `submitText`/`resetText` are NOT slotted (Task 14c): each is fed
 *   straight into `Button`'s (or the replicated submit button's) `text`
 *   prop, a plain string sink — same "sink can't carry what's needed"
 *   case as `Tag.content`/`Button.text` elsewhere. `formAttributes` is
 *   NOT slotted: it is consumed as a Drupal Attribute object spread onto
 *   the `<form>` element (and its mere presence decides whether a `<form>`
 *   wraps the row at all) — an attribute bag, not markup. `items` is NOT
 *   slotted: it is structured per-item data (`text`/`isSelected`/`name`)
 *   that drives live `Chip` children, not a single HTML-bearing value —
 *   a slot has no analogous "array of items" semantics.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: `single-filter.twig` includes `@base/item-list/item-list.twig`
 * with each filter's rendered `Chip` markup captured as a string.
 * `ItemList`'s `items` prop is typed for raw HTML strings, which a live
 * `Chip` component can't be turned into without a nested Container
 * render — so, matching `TagList`/`SocialLinks`/`Tabs`'s precedent, the
 * `<ul>`/`<li>` wrapper is reproduced directly here with real `Chip`
 * children (`ItemList`'s class-list formula for `direction=horizontal,
 * size=small, noGap=false` is `ct-item-list ct-item-list--horizontal
 * ct-item-list--small ct-single-filter__list`).
 *
 * Note: the submit button needs a native `type="submit"` HTML attribute
 * distinct from `Button`'s own visual `type` prop (`primary`) —
 * `Button.astro`'s `type` prop destructure consumes that key entirely, so
 * `...rest` can never carry a second, different `type` value through it.
 * Replicated `Button`'s own `kind === 'button'` markup formula directly
 * here (real `TextIcon` child, same class-list formula), matching
 * `GroupFilter`'s precedent for this exact situation. See PORTING.md.
 */
import Chip from '@civictheme/atoms/Chip.astro';
import Button from '@civictheme/atoms/Button.astro';
import TextIcon from '@civictheme/base/TextIcon.astro';

interface FilterItem {
  text?: string;
  isSelected?: boolean;
  name?: string;
  [key: string]: unknown;
}

interface Props {
  theme?: 'light' | 'dark';
  isMultiple?: boolean;
  items?: FilterItem[];
  formAttributes?: Record<string, unknown>;
  formHiddenFields?: string;
  contentTop?: string;
  title?: string;
  submitText?: string;
  resetText?: string;
  contentBottom?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  isMultiple,
  items,
  formAttributes,
  formHiddenFields,
  contentTop,
  title: titleProp,
  submitText,
  resetText,
  contentBottom,
  class: className = '',
  ...rest
} = Astro.props;

const hasItems = Boolean(items && items.length > 0);
const title = titleProp || 'Filter results by:';
const classes = ['ct-single-filter', `ct-theme-${theme}`, className].filter(Boolean).join(' ');
const withForm = Boolean(formAttributes);
const formWrapperProps = formAttributes ?? {};

// item-list.twig's `item is not empty` check does not filter items out of
// the array — a text-less item still gets its own `<li>` (Twig's `empty`
// test on a string is only true for the literal empty string `''`, and
// single-filter.twig's per-item `{% set filter_item %}...{% endset %}`
// capture, un-trimmed, is never truly empty even when `item.text` is —
// it carries the whitespace between the `set`/`endset` tags). So this
// maps over every item, rendering an empty `<li>` for a text-less one,
// rather than filtering the array first.
const filterItems = items ?? [];

const submitClasses = [
  'ct-button',
  `ct-theme-${theme}`,
  'ct-button--primary',
  'ct-button--button',
  'ct-button--small',
  'ct-single-filter__submit',
]
  .filter(Boolean)
  .join(' ');

const hasContentTopSlot = Astro.slots.has('contentTop');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasTitleSlot = Astro.slots.has('title');
const hasFormHiddenFieldsSlot = Astro.slots.has('formHiddenFields');
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;
const hasTitle = Boolean(title) || hasTitleSlot;
const hasFormHiddenFields = Boolean(formHiddenFields) || hasFormHiddenFieldsSlot;
---

{
  hasItems && (
    <div class={classes} data-component-name="ct-single-filter" {...rest}>
      <div class="container">
        <div class="row">
          <div class="col-xxs-12">
            {hasContentTop && (
              <Fragment>
                <div class="ct-single-filter__content-top">
                  {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
                </div>{' '}
              </Fragment>
            )}
            {withForm ? (
              <form {...formWrapperProps}>
                {hasTitle &&
                  (hasTitleSlot ? (
                    <div class="ct-single-filter__title">
                      <slot name="title" />
                    </div>
                  ) : (
                    title && <div class="ct-single-filter__title">{title}</div>
                  ))}{' '}
                <div class="ct-single-filter__wrapper">
                  <div class="ct-single-filter__items">
                    <ul class="ct-item-list ct-item-list--horizontal ct-item-list--small ct-single-filter__list">
                      {filterItems.map(({ text, isSelected, name, ...itemRest }, i) => (
                        <Fragment>
                          {i > 0 && ' '}
                          <li class="ct-item-list__item">
                            {text && (
                              <Chip
                                theme={theme}
                                kind="input"
                                size="small"
                                isMultiple={isMultiple}
                                isSelected={isSelected ?? false}
                                content={text}
                                groupParent=".ct-single-filter"
                                name={name ?? (isMultiple ? `single-filter-${i + 1}` : 'single-filter')}
                                {...itemRest}
                              />
                            )}
                          </li>
                        </Fragment>
                      ))}
                    </ul>
                  </div>{' '}
                  <div class="ct-single-filter__actions">
                    <button class={submitClasses} data-component-name="button" type="submit">
                      <TextIcon
                        text={submitText || 'Apply filter'}
                        icon="approve"
                        iconPlacement="after"
                        iconClass="ct-button__icon"
                      />
                    </button>
                    {resetText && (
                      <Fragment>
                        {' '}
                        <Button
                          theme={theme}
                          kind="reset"
                          type="secondary"
                          size="small"
                          text={resetText || 'Clear all'}
                          icon="close-outline"
                          iconPlacement="after"
                          class="ct-single-filter__submit"
                        />
                      </Fragment>
                    )}
                  </div>
                </div>
                {hasFormHiddenFields &&
                  (hasFormHiddenFieldsSlot ? (
                    <slot name="formHiddenFields" />
                  ) : (
                    <Fragment set:html={formHiddenFields} />
                  ))}
              </form>
            ) : (
              <Fragment>
                {hasTitle &&
                  (hasTitleSlot ? (
                    <div class="ct-single-filter__title">
                      <slot name="title" />
                    </div>
                  ) : (
                    title && <div class="ct-single-filter__title">{title}</div>
                  ))}{' '}
                <div class="ct-single-filter__wrapper">
                  <div class="ct-single-filter__items">
                    <ul class="ct-item-list ct-item-list--horizontal ct-item-list--small ct-single-filter__list">
                      {filterItems.map(({ text, isSelected, name, ...itemRest }, i) => (
                        <Fragment>
                          {i > 0 && ' '}
                          <li class="ct-item-list__item">
                            {text && (
                              <Chip
                                theme={theme}
                                kind="input"
                                size="small"
                                isMultiple={isMultiple}
                                isSelected={isSelected ?? false}
                                content={text}
                                groupParent=".ct-single-filter"
                                name={name ?? (isMultiple ? `single-filter-${i + 1}` : 'single-filter')}
                                {...itemRest}
                              />
                            )}
                          </li>
                        </Fragment>
                      ))}
                    </ul>
                  </div>{' '}
                  <div class="ct-single-filter__actions">
                    <button class={submitClasses} data-component-name="button" type="submit">
                      <TextIcon
                        text={submitText || 'Apply filter'}
                        icon="approve"
                        iconPlacement="after"
                        iconClass="ct-button__icon"
                      />
                    </button>
                    {resetText && (
                      <Fragment>
                        {' '}
                        <Button
                          theme={theme}
                          kind="reset"
                          type="secondary"
                          size="small"
                          text={resetText || 'Clear all'}
                          icon="close-outline"
                          iconPlacement="after"
                          class="ct-single-filter__submit"
                        />
                      </Fragment>
                    )}
                  </div>
                </div>
                {hasFormHiddenFields &&
                  (hasFormHiddenFieldsSlot ? (
                    <slot name="formHiddenFields" />
                  ) : (
                    <Fragment set:html={formHiddenFields} />
                  ))}
              </Fragment>
            )}
            {hasContentBottom && (
              <Fragment>
                {' '}
                <div class="ct-single-filter__content-bottom">
                  {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
                </div>
              </Fragment>
            )}
          </div>
        </div>
      </div>
    </div>
  )
}
