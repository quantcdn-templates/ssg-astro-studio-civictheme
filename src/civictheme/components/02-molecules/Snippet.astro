---
/**
 * CivicTheme Snippet component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - link: Snippet link object: { text, url, isNewWindow, isExternal }.
 * - contentTop / contentMiddle / contentBottom / title / summary / tags:
 *   Documented as Slots upstream, but every upstream test passes plain
 *   string/array props — ported as props, string ones rendered with
 *   `set:html` per this project's autoescape convention.
 * - tags: Snippet tags, passed straight through to `TagList` (see
 *   PORTING.md's tag-list revisit note).
 * - `contentTop`/`contentMiddle`/`contentBottom`/`title`/`summary` also
 *   now have a same-named Astro slot that TAKES PRECEDENCE over the
 *   string prop when present (Task 14c); every wrapper `{% if %}` gate
 *   (root included, via `title`) widens to
 *   `Boolean(prop) || Astro.slots.has('prop')`. `summary` routes the
 *   string-prop branch through `Paragraph`, so a slot bypasses that
 *   wrapper. `tags` is NOT slotted: it is structured array data fed
 *   straight into `TagList`'s `tags` prop, not a single HTML value.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
import Paragraph from '@civictheme/atoms/Paragraph.astro';
import TagList from '@civictheme/molecules/TagList.astro';

interface Props {
  theme?: 'light' | 'dark';
  link?: { text?: string; url?: string; isNewWindow?: boolean; isExternal?: boolean };
  contentTop?: string;
  contentMiddle?: string;
  contentBottom?: string;
  title?: string;
  summary?: string;
  tags?: Array<string | Record<string, unknown>>;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  link,
  contentTop,
  contentMiddle,
  contentBottom,
  title,
  summary,
  tags,
  class: className = '',
  ...rest
} = Astro.props;

const withLink = Boolean(link?.url);
const classes = ['ct-snippet', `ct-theme-${theme}`, className].filter(Boolean).join(' ');
const hasTags = Boolean(tags && tags.length > 0);

const hasContentTopSlot = Astro.slots.has('contentTop');
const hasTitleSlot = Astro.slots.has('title');
const hasContentMiddleSlot = Astro.slots.has('contentMiddle');
const hasSummarySlot = Astro.slots.has('summary');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasTitle = Boolean(title) || hasTitleSlot;
const hasContentMiddle = Boolean(contentMiddle) || hasContentMiddleSlot;
const hasSummary = Boolean(summary) || hasSummarySlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;
---

{
  hasTitle && (
    <div class={classes} {...rest}>
      <div class="ct-snippet__content">
        {hasContentTop && (
          <Fragment>
            <div class="ct-snippet__content-top">
              {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
            </div>{' '}
          </Fragment>
        )}
        <div class="ct-snippet__title">
          {withLink ? (
            <a class="ct-snippet__title-link" href={link?.url} target={link?.isNewWindow ? '_blank' : undefined}>
              {hasTitleSlot ? <slot name="title" /> : <Fragment set:html={title} />}
            </a>
          ) : hasTitleSlot ? (
            <slot name="title" />
          ) : (
            <Fragment set:html={title} />
          )}
        </div>
        {hasContentMiddle && (
          <Fragment>
            {' '}
            <div class="ct-snippet__content-middle">
              {hasContentMiddleSlot ? <slot name="contentMiddle" /> : <Fragment set:html={contentMiddle} />}
            </div>
          </Fragment>
        )}
        {hasSummary && (
          <Fragment>
            {' '}
            {hasSummarySlot ? (
              <slot name="summary" />
            ) : (
              <Paragraph theme={theme} content={summary} noMargin class="ct-snippet__summary" />
            )}
          </Fragment>
        )}
        {hasTags && (
          <Fragment>
            {' '}
            <div class="ct-snippet__tags">
              <TagList theme={theme} tags={tags} />
            </div>
          </Fragment>
        )}
        {hasContentBottom && (
          <Fragment>
            {' '}
            <div class="ct-snippet__content-bottom">
              {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
            </div>
          </Fragment>
        )}
      </div>
    </div>
  )
}
