---
/**
 * CivicTheme Field component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - type: Type defined by a control type (required; defaults to 'hidden').
 * - title: Field title.
 * - titleDisplay: How to display the field title (visible, invisible, hidden).
 * - titleSize: The size of the title (extra-small, small, regular, large, extra-large).
 * - label: Control label (required only for a radio group or checkbox).
 * - description: Field description (HTML-bearing).
 * - name: Control DOM name (propagated from `name` if not defined on `control`).
 * - value: Control DOM value (propagated likewise).
 * - id: Control DOM ID (propagated likewise).
 * - isInvalid / isDisabled / isRequired: Propagated to `control` likewise.
 * - requiredText: Text to display within label element when required.
 * - orientation: Elements orientation (vertical or horizontal).
 * - isInline: Whether the checkbox/radio control list is shown inline.
 * - control: A single control object, or an array of them (required for
 *   complex controls like checkbox/radio groups): { theme, label, name,
 *   value, id, options, isMultiple, isRequired, requiredText, isInvalid,
 *   isDisabled, isChecked, class, ...rest }.
 * - options: Options for the field input: { value, label }.
 * - isMultiple: Whether the field allows multiple values.
 * - placeholder: Placeholder text for field.
 * - message: Message object for showing messages: { content, ...rest }.
 * - prefix / suffix: Content to add before/after the field (HTML-bearing).
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: `field.twig`'s `description_content`/`message_content` "default
 * error message" branches (`{% if not description and is_invalid %}` inside
 * a block already gated on `description` being truthy) are unreachable
 * upstream dead code for `description` — only `message`'s equivalent branch
 * is reachable (it is NOT nested inside a `message`-truthy gate). Ported to
 * match: `description` is used as-is when present, never replaced by an
 * error message; `message`'s default error text IS computed and used.
 */
import Label from '@civictheme/atoms/Label.astro';
import FieldDescription from '@civictheme/atoms/FieldDescription.astro';
import FieldMessage from '@civictheme/atoms/FieldMessage.astro';
import Textfield from '@civictheme/atoms/Textfield.astro';
import Textarea from '@civictheme/atoms/Textarea.astro';
import Select from '@civictheme/atoms/Select.astro';
import Checkbox from '@civictheme/atoms/Checkbox.astro';
import Radio from '@civictheme/atoms/Radio.astro';
import Input from '@civictheme/atoms/Input.astro';

interface ControlItem {
  theme?: 'light' | 'dark';
  label?: string;
  name?: string;
  value?: string;
  id?: string;
  options?: unknown[];
  isMultiple?: boolean;
  isRequired?: boolean;
  requiredText?: string;
  isInvalid?: boolean;
  isDisabled?: boolean;
  isChecked?: boolean;
  class?: string;
  [key: string]: unknown;
}

interface Props {
  theme?: 'light' | 'dark';
  type?: string;
  title?: string;
  titleDisplay?: 'visible' | 'invisible' | 'hidden';
  titleSize?: 'extra-small' | 'small' | 'regular' | 'large' | 'extra-large';
  label?: string;
  description?: string;
  name?: string;
  value?: string;
  id?: string;
  isInvalid?: boolean;
  isDisabled?: boolean;
  isRequired?: boolean;
  requiredText?: string;
  orientation?: 'vertical' | 'horizontal';
  isInline?: boolean;
  control?: ControlItem | ControlItem[];
  options?: unknown[];
  isMultiple?: boolean;
  placeholder?: string;
  message?: { content?: string; [key: string]: unknown };
  prefix?: string;
  suffix?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  type: typeProp,
  title,
  titleDisplay: titleDisplayProp,
  titleSize: titleSizeProp,
  label,
  description,
  name,
  value,
  id,
  isInvalid: isInvalidProp,
  isDisabled: isDisabledProp,
  isRequired: isRequiredProp,
  requiredText,
  orientation: orientationProp,
  isInline,
  control,
  options,
  isMultiple,
  placeholder,
  message,
  prefix,
  suffix,
  class: className = '',
  ...rest
} = Astro.props;

const type = typeProp ?? 'hidden';
const titleDisplay = (['visible', 'invisible', 'hidden'] as const).includes(titleDisplayProp as any)
  ? titleDisplayProp!
  : 'visible';
const titleSize = (['extra-small', 'small', 'regular', 'large', 'extra-large'] as const).includes(titleSizeProp as any)
  ? titleSizeProp!
  : '';
const isInvalid = isInvalidProp ?? false;
const isDisabled = isDisabledProp ?? false;
const isRequired = isRequiredProp ?? false;
const orientation = (['vertical', 'horizontal'] as const).includes(orientationProp as any)
  ? orientationProp!
  : 'vertical';

const classes = [
  'ct-field',
  `ct-theme-${theme}`,
  `ct-field--${type}`,
  `ct-field--${orientation}`,
  isRequired && 'ct-field--required',
  isDisabled && 'ct-field--disabled',
  isInvalid && 'ct-field--invalid',
  className,
]
  .filter(Boolean)
  .join(' ');

const controlsRaw: ControlItem[] = Array.isArray(control) ? control : control ? [control] : [{ name }];

interface MergedControl {
  theme: 'light' | 'dark';
  label?: string;
  name?: string;
  value?: string;
  id?: string;
  options: unknown[];
  isMultiple: boolean;
  placeholder: string;
  isRequired: boolean;
  requiredText?: string;
  isInvalid: boolean;
  isDisabled: boolean;
  isChecked: boolean;
  modifierClass: string;
  rest: Record<string, unknown>;
}

function mergeControl(c: ControlItem): MergedControl {
  const {
    theme: cTheme,
    label: cLabel,
    name: cName,
    value: cValue,
    id: cId,
    options: cOptions,
    isMultiple: cIsMultiple,
    isRequired: cIsRequired,
    requiredText: cRequiredText,
    isInvalid: cIsInvalid,
    isDisabled: cIsDisabled,
    isChecked: cIsChecked,
    class: cModifierClass,
    ...restAttrs
  } = c;
  return {
    theme: (cTheme ?? theme) as 'light' | 'dark',
    label: cLabel ?? title,
    name: cName ?? name,
    value: cValue ?? value,
    id: cId ?? id,
    options: cOptions ?? options ?? [],
    isMultiple: cIsMultiple ?? isMultiple ?? false,
    placeholder: placeholder ?? '',
    isRequired: cIsRequired ?? isRequired,
    requiredText: cRequiredText || requiredText,
    isInvalid: cIsInvalid ?? isInvalid,
    isDisabled: cIsDisabled ?? isDisabled,
    isChecked: cIsChecked ?? false,
    modifierClass: cModifierClass ? `ct-field__control ${cModifierClass}` : 'ct-field__control',
    rest: restAttrs,
  };
}

const controls = controlsRaw.map(mergeControl);
const control0 = controls[0];
const fieldWrapper = type === 'checkbox' || type === 'radio' ? 'fieldset' : 'div';
const FieldWrapperTag = fieldWrapper as 'div' | 'fieldset';

const outerLabelFor = control0.id && type !== 'radio' && type !== 'checkbox' ? control0.id : undefined;
const titleClass = `ct-field__title${titleDisplay === 'invisible' ? ' ct-visually-hidden' : ''}`;

// field.twig's `description_content` "default error message" fallback
// (`{% if not description and is_invalid %}`) is nested inside a block
// already gated on `description` being truthy — unreachable dead code, so
// `description` is used as-is here, never replaced by a computed error
// message (unlike `message`'s equivalent branch below, which IS reachable).
const descriptionContent = description;

const showMessage = Boolean(message || isInvalid) && type !== 'hidden';
const messageErrorText = title ? `Field <em>${title}</em> has an error` : 'Field has an error';
let messageContent: string | undefined;
if (isInvalid) messageContent = messageErrorText;
if (message && message.content !== undefined) messageContent = message.content;
const messageRest = message ? Object.fromEntries(Object.entries(message).filter(([k]) => k !== 'content')) : {};
---

{
  control0.name !== undefined && (
    <div class={classes} {...rest}>
      {title && titleDisplay !== 'hidden' && type !== 'hidden' && type !== 'checkbox' && type !== 'radio' && (
        <Fragment>
          <Label
            theme={theme}
            content={label || title}
            size={titleSize || 'regular'}
            isRequired={isRequired}
            requiredText={requiredText}
            for={outerLabelFor}
            class={titleClass}
          />{' '}
        </Fragment>
      )}
      <FieldWrapperTag class="ct-field__wrapper">
        {title && titleDisplay !== 'hidden' && (type === 'checkbox' || type === 'radio') && (
          <Fragment>
            <Label theme={theme} tag="legend" content={title} isRequired={isRequired} class={titleClass} />{' '}
          </Fragment>
        )}
        {descriptionContent && type !== 'hidden' && (
          <Fragment>
            <FieldDescription theme={theme} content={descriptionContent} class="ct-field__description" />{' '}
          </Fragment>
        )}
        {prefix && (
          <Fragment>
            <div class="ct-field__prefix" set:html={prefix} />{' '}
          </Fragment>
        )}
        {type === 'textfield' ? (
          <Textfield
            theme={control0.theme}
            name={control0.name}
            id={control0.id}
            value={control0.value}
            placeholder={control0.placeholder}
            isInvalid={control0.isInvalid}
            isDisabled={control0.isDisabled}
            isRequired={control0.isRequired}
            class={control0.modifierClass}
            {...control0.rest}
          />
        ) : type === 'textarea' ? (
          <Textarea
            theme={control0.theme}
            name={control0.name}
            id={control0.id}
            value={control0.value}
            placeholder={control0.placeholder}
            isInvalid={control0.isInvalid}
            isDisabled={control0.isDisabled}
            isRequired={control0.isRequired}
            class={control0.modifierClass}
            {...control0.rest}
          />
        ) : type === 'select' ? (
          <Select
            theme={control0.theme}
            name={control0.name}
            id={control0.id}
            isMultiple={control0.isMultiple}
            options={control0.options as any}
            isInvalid={control0.isInvalid}
            isDisabled={control0.isDisabled}
            isRequired={control0.isRequired}
            class={control0.modifierClass}
            {...control0.rest}
          />
        ) : type === 'checkbox' || type === 'radio' ? (
          <ul class={`ct-item-list ct-item-list--${isInline ? 'horizontal' : 'vertical'} ct-item-list--regular`}>
            {controls.map((c, i) => (
              <Fragment>
                {i > 0 && ' '}
                <li class="ct-item-list__item">
                  {type === 'checkbox' ? (
                    <Checkbox
                      theme={c.theme}
                      name={c.name}
                      id={c.id}
                      value={c.value}
                      label={c.label}
                      isChecked={c.isChecked}
                      isRequired={c.isRequired}
                      isInvalid={c.isInvalid}
                      isDisabled={c.isDisabled}
                      class={c.modifierClass}
                      {...c.rest}
                    />
                  ) : (
                    <Radio
                      theme={c.theme}
                      name={c.name}
                      id={c.id}
                      value={c.value}
                      label={c.label}
                      isChecked={c.isChecked}
                      isRequired={c.isRequired}
                      isInvalid={c.isInvalid}
                      isDisabled={c.isDisabled}
                      class={c.modifierClass}
                      {...c.rest}
                    />
                  )}
                </li>
              </Fragment>
            ))}
          </ul>
        ) : (
          <Input
            type={type}
            theme={control0.theme}
            name={control0.name}
            id={control0.id}
            value={control0.value}
            placeholder={control0.placeholder}
            isInvalid={control0.isInvalid}
            isDisabled={control0.isDisabled}
            isRequired={control0.isRequired}
            class={control0.modifierClass}
            {...control0.rest}
          />
        )}
        {suffix && (
          <Fragment>
            {' '}
            <div class="ct-field__suffix" set:html={suffix} />
          </Fragment>
        )}
        {showMessage && (
          <Fragment>
            {' '}
            <FieldMessage
              theme={theme}
              type={isInvalid ? 'error' : 'information'}
              content={messageContent}
              class="ct-field__message"
              {...messageRest}
            />
          </Fragment>
        )}
      </FieldWrapperTag>
    </div>
  )
}
