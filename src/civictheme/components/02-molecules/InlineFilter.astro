---
/**
 * CivicTheme Inline Filter component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - title: Filter title.
 * - submitText: The text of the submit button.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Slots:
 * - items: Field items to display. Ideally a single text field.
 * - itemsEnd: Field items to appear after the `items` slot.
 *
 * Both slots also have a same-named `string` prop rendered with `set:html`;
 * the slot TAKES PRECEDENCE when present. Upstream's
 * `inline-filter.stories.js` passes pre-rendered field markup as strings,
 * which is also how a Drupal caller feeds `items`/`items_end`.
 *
 * Note: `inline-filter.twig` has no upstream `.test.js` / `__snapshots__`
 * in `.upstream/uikit/packages/twig/components/02-molecules/inline-filter`
 * (only `.scss`/`.stories.*` files exist there) — ported as a real Astro
 * slot component (rather than string props, since `items`/`items_end` are
 * genuinely arbitrary markup, not scalar text) with a smoke test, per the
 * project's established rule for components with no upstream test (see
 * `TextIcon.parity.test.ts`).
 *
 * Note: the submit button needs a native `type="submit"` HTML attribute
 * distinct from `Button`'s own visual `type` prop (`primary`) — same
 * conflict, and same "replicate Button's own markup formula directly"
 * resolution, as GroupFilter's submit button. See PORTING.md.
 */
import TextIcon from '@civictheme/base/TextIcon.astro';

interface Props {
  theme?: 'light' | 'dark';
  title?: string;
  submitText?: string;
  items?: string;
  itemsEnd?: string;
  class?: string;
  [key: string]: unknown;
}

const { theme = 'light', title, submitText, items, itemsEnd, class: className = '', ...rest } = Astro.props;

const classes = ['ct-inline-filter', `ct-theme-${theme}`, className].filter(Boolean).join(' ');
const hasItemsSlot = Astro.slots.has('items');
const hasItemsEndSlot = Astro.slots.has('itemsEnd');
const hasItems = hasItemsSlot || Boolean(items);
const hasItemsEnd = hasItemsEndSlot || Boolean(itemsEnd);
const submitClasses = [
  'ct-button',
  `ct-theme-${theme}`,
  'ct-button--primary',
  'ct-button--button',
  'ct-button--regular',
  'ct-inline-filter__submit-button',
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} {...rest}>
  {
    title && (
      <Fragment>
        <div class="ct-inline-filter__title">{title}</div>{' '}
      </Fragment>
    )
  }
  <div class="ct-inline-filter__content">
    {
      hasItems && (
        <div class="ct-inline-filter__items">
          {hasItemsSlot ? <slot name="items" /> : <Fragment set:html={items} />}{' '}
          <div class="ct-inline-filter__actions">
            <button class={submitClasses} data-component-name="button" type="submit">
              <TextIcon text={submitText || 'Search'} />
            </button>
          </div>
        </div>
      )
    }
    {
      hasItemsEnd && (
        <div class="ct-inline-filter__items-end">
          {hasItemsEndSlot ? <slot name="itemsEnd" /> : <Fragment set:html={itemsEnd} />}
        </div>
      )
    }
  </div>
</div>
