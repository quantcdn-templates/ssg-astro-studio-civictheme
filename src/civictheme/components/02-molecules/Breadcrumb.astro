---
/**
 * CivicTheme Breadcrumb component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - activeIsLink: Whether to show the active element as a link.
 * - links: Breadcrumb links: { text, url }.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <nav>.
 *
 * Note: `breadcrumb.twig` builds each rendered link/separator via an
 * untrimmed-but-inner-trimmed `{% set link_item %}` capture (a `@atoms/link`
 * include, plus a `@base/icon` separator when not the last link) and feeds
 * the array of captured strings, plus a second single-item "parent" link
 * array, to two separate `@base/item-list/item-list.twig` includes (mobile
 * "back" link, desktop full trail). Same "single string items target"
 * limitation as Attachment/Grid/Chip in PORTING.md — both `<ul>` wrappers
 * ItemList would produce are inlined directly here (their class lists are
 * deterministic) with real `Link`/`Icon` components as children.
 */
import Link from '@civictheme/atoms/Link.astro';
import Icon from '@civictheme/base/Icon.astro';

interface Props {
  theme?: 'light' | 'dark';
  activeIsLink?: boolean;
  links?: Array<{ text?: string; url?: string }>;
  class?: string;
  [key: string]: unknown;
}

const { theme = 'light', activeIsLink, links, class: className = '', ...rest } = Astro.props;

const classes = ['ct-breadcrumb', `ct-theme-${theme}`, className].filter(Boolean).join(' ');

const linkList = links ?? [];
const count = linkList.length;
const parent = count >= 2 ? linkList[count - 2] : null;
---

{
  count > 0 && (
    <nav class={classes} aria-label="breadcrumb" {...rest}>
      {parent && (
        <Fragment>
          <ul class="ct-item-list ct-item-list--horizontal ct-item-list--regular ct-breadcrumb__links show-xxs-flex hide-m">
            <li class="ct-item-list__item">
              <Link
                theme={theme}
                text={parent.text}
                url={parent.url}
                icon="left-arrow"
                iconPlacement="before"
                class="ct-breadcrumb__links__link"
              />
            </li>
          </ul>{' '}
        </Fragment>
      )}
      <ul class="ct-item-list ct-item-list--horizontal ct-item-list--regular ct-item-list--no-gap ct-breadcrumb__links hide-xxs show-m-flex">
        {linkList.map((link, i) => {
          const isLast = i === count - 1;
          const asSpan = isLast && (!activeIsLink || !link.url);
          return (
            <Fragment>
              {i > 0 && ' '}
              <li class="ct-item-list__item">
                {asSpan ? (
                  <span class="ct-breadcrumb__links__link ct-breadcrumb__links__link--active" aria-current="location">
                    {link.text}
                  </span>
                ) : (
                  <Fragment>
                    <Link
                      theme={theme}
                      text={link.text}
                      url={link.url}
                      isActive={isLast}
                      aria-current={isLast ? 'location' : undefined}
                      class={isLast ? 'ct-breadcrumb__links__link ct-breadcrumb__links__link--active' : 'ct-breadcrumb__links__link'}
                    />
                    {!isLast && (
                      <Icon symbol="right-arrow-1" class="ct-breadcrumb__links__separator" />
                    )}
                  </Fragment>
                )}
              </li>
            </Fragment>
          );
        })}
      </ul>
    </nav>
  )
}
