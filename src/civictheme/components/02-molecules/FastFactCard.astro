---
/**
 * CivicTheme Fast Fact Card component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - image: Image data: { url, alt }.
 * - title: Title text for the card.
 * - summary: Summary text content (HTML-bearing).
 * - link: Link object for making the title clickable: { url, isNewWindow }.
 * - isTitleClick: Whether to make only the title clickable instead of the
 *   whole card.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
import Image from '@civictheme/atoms/Image.astro';
import Paragraph from '@civictheme/atoms/Paragraph.astro';

interface Props {
  theme?: 'light' | 'dark';
  image?: { url?: string; alt?: string };
  title?: string;
  summary?: string;
  link?: { url?: string; isNewWindow?: boolean };
  isTitleClick?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { theme = 'light', image, title, summary, link, isTitleClick, class: className = '', ...rest } = Astro.props;

const withLink = Boolean(link?.url);
const isCardClickable = withLink && !isTitleClick;

const classes = [
  'ct-fast-fact-card',
  `ct-theme-${theme}`,
  isCardClickable && 'ct-fast-fact-card--card-clickable',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} {...rest}>
  {image?.url && (
    <Fragment>
      <div class="ct-fast-fact-card__image">
        <Image theme={theme} url={image.url} alt={image.alt ?? ''} />
      </div>{' '}
    </Fragment>
  )}
  {title && (
    <Fragment>
      <div class="ct-fast-fact-card__title">
        {withLink ? (
          <a class="ct-fast-fact-card__title-link" href={link?.url} target={link?.isNewWindow ? '_blank' : undefined}>
            {title}
          </a>
        ) : (
          title
        )}
      </div>{' '}
    </Fragment>
  )}
  {summary && <Paragraph theme={theme} content={summary} size="large" class="ct-fast-fact-card__summary" />}
</div>
