---
/**
 * CivicTheme Callout component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - verticalSpacing: Vertical spacing position (top, bottom, both).
 * - title / content / contentTop / contentBottom: Documented as Slots
 *   upstream, but every upstream test passes plain string props — ported as
 *   `string` props (title rendered as plain text via Heading, the rest via
 *   `set:html`), matching Fieldset's `fields` precedent.
 * - links: Callout links: { text, url, isNewWindow, isExternal }.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: `callout.twig`'s `links_block` builds each link via `@atoms/button`
 * (kind 'link', type 'primary' for the first, 'secondary' for the rest),
 * feeding the array to `@base/item-list/item-list.twig` — same
 * "single string items target" limitation as Attachment/Breadcrumb/Grid.
 * The `<ul>` wrapper ItemList would produce is inlined directly (its class
 * list is deterministic) with real `Button` components as children.
 */
import Heading from '@civictheme/atoms/Heading.astro';
import Paragraph from '@civictheme/atoms/Paragraph.astro';
import Button from '@civictheme/atoms/Button.astro';

interface Props {
  theme?: 'light' | 'dark';
  verticalSpacing?: 'top' | 'bottom' | 'both';
  title?: string;
  content?: string;
  contentTop?: string;
  contentBottom?: string;
  links?: Array<{ text?: string; url?: string; isNewWindow?: boolean; isExternal?: boolean }>;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  verticalSpacing,
  title,
  content,
  contentTop,
  contentBottom,
  links,
  class: className = '',
  ...rest
} = Astro.props;

const verticalSpacingClass = (['top', 'bottom', 'both'] as const).includes(verticalSpacing as any)
  ? `ct-vertical-spacing-inset--${verticalSpacing}`
  : '';

const classes = ['ct-callout', `ct-theme-${theme}`, verticalSpacingClass, className].filter(Boolean).join(' ');

const linkList = links ?? [];
---

<div class={classes} {...rest}>
  <div class="container">
    <div class="row">
      <div class="col-xxs-12">
        <div class="ct-callout__wrapper">
          {contentTop && (
            <Fragment>
              <div class="ct-callout__content-top" set:html={contentTop} />{' '}
            </Fragment>
          )}
          {(title || content) && (
            <Fragment>
              <div class="ct-callout__inner">
                {title && <Heading content={title} level={4} theme={theme} class="ct-callout__title" />}
                {title && content && ' '}
                {content && <Paragraph theme={theme} content={content} noMargin class="ct-callout__content" />}
              </div>{' '}
            </Fragment>
          )}
          {linkList.length > 0 && (
            <ul class="ct-item-list ct-item-list--horizontal ct-item-list--small ct-callout__links">
              {linkList.map((link, i) => (
                <Fragment>
                  {i > 0 && ' '}
                  <li class="ct-item-list__item">
                    <Button
                      theme={theme}
                      kind="link"
                      type={i > 0 ? 'secondary' : 'primary'}
                      text={link.text}
                      url={link.url}
                      isExternal={link.isExternal}
                      isNewWindow={link.isNewWindow}
                    />
                  </li>
                </Fragment>
              ))}
            </ul>
          )}
          {contentBottom && (
            <Fragment>
              {' '}
              <div class="ct-callout__content-bottom" set:html={contentBottom} />
            </Fragment>
          )}
        </div>
      </div>
    </div>
  </div>
</div>
