---
/**
 * CivicTheme Navigation Card component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - imageAsIcon: Whether to show the image as an icon.
 * - image: Card image: { url, alt }.
 * - link: Link object: { text, url, isNewWindow, isExternal }.
 * - isTitleClick: Whether to make only the title clickable instead of the
 *   whole card.
 * - icon / title / summary / contentTop / imageOver / contentMiddle /
 *   contentBottom: Documented as Slots upstream, but every upstream test
 *   passes plain string props — ported as `string` props, ALL rendered
 *   with `set:html` per this project's autoescape convention, except
 *   `icon`, which is an icon symbol name, not HTML. `title`/`summary`/
 *   `contentTop`/`imageOver`/`contentMiddle`/`contentBottom` also now have
 *   a same-named Astro slot that TAKES PRECEDENCE over the string prop
 *   when present (Task 14c); every wrapper `{% if %}` gate (root included,
 *   via `title`) widens to `Boolean(prop) || Astro.slots.has('prop')`.
 *   `icon` is NOT slotted (Task 14c): it is a data value fed into a
 *   sibling `Icon`'s `symbol` prop, not markup — a slot has no analogue
 *   for "which icon symbol to draw".
 *   `summary` routes the string-prop branch through `Paragraph`, so a slot
 *   bypasses that wrapper and renders the caller's markup directly.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
import Image from '@civictheme/atoms/Image.astro';
import Paragraph from '@civictheme/atoms/Paragraph.astro';
import Icon from '@civictheme/base/Icon.astro';

interface Props {
  theme?: 'light' | 'dark';
  imageAsIcon?: boolean;
  image?: { url?: string; alt?: string };
  link?: { text?: string; url?: string; isNewWindow?: boolean; isExternal?: boolean };
  isTitleClick?: boolean;
  icon?: string;
  title?: string;
  summary?: string;
  contentTop?: string;
  imageOver?: string;
  contentMiddle?: string;
  contentBottom?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  imageAsIcon,
  image,
  link,
  isTitleClick,
  icon,
  title,
  summary,
  contentTop,
  imageOver,
  contentMiddle,
  contentBottom,
  class: className = '',
  ...rest
} = Astro.props;

const withImage = Boolean(image?.url);
const withLink = Boolean(link?.url);
const isCardClickable = withLink && !isTitleClick;

const classes = [
  'ct-navigation-card',
  `ct-theme-${theme}`,
  withImage && 'ct-navigation-card--with-image',
  withLink && 'ct-navigation-card--with-link',
  imageAsIcon && 'ct-navigation-card--image-as-icon',
  isCardClickable && 'ct-navigation-card--card-clickable',
  className,
]
  .filter(Boolean)
  .join(' ');

const withIconBlock = Boolean(icon) || (withImage && imageAsIcon);

const hasImageOverSlot = Astro.slots.has('imageOver');
const hasContentTopSlot = Astro.slots.has('contentTop');
const hasTitleSlot = Astro.slots.has('title');
const hasContentMiddleSlot = Astro.slots.has('contentMiddle');
const hasSummarySlot = Astro.slots.has('summary');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasImageOver = Boolean(imageOver) || hasImageOverSlot;
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasTitle = Boolean(title) || hasTitleSlot;
const hasContentMiddle = Boolean(contentMiddle) || hasContentMiddleSlot;
const hasSummary = Boolean(summary) || hasSummarySlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;
---

{
  hasTitle && (
    <div class={classes} {...rest}>
      {!imageAsIcon && image?.url && (
        <Fragment>
          <div class="ct-navigation-card__image">
            <Image theme={theme} url={image.url} alt={image.alt} />
            {hasImageOver && (
              <Fragment>
                {' '}
                <div class="ct-navigation-card__image__over">
                  {hasImageOverSlot ? <slot name="imageOver" /> : <Fragment set:html={imageOver} />}
                </div>
              </Fragment>
            )}
          </div>{' '}
        </Fragment>
      )}
      <div class="ct-navigation-card__content">
        {hasContentTop && (
          <Fragment>
            <div class="ct-navigation-card__content-top">
              {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
            </div>{' '}
          </Fragment>
        )}
        {withIconBlock && (
          <Fragment>
            <div class="ct-navigation-card__icon">
              {icon && <Icon symbol={icon} size="extra-large" />}
              {icon && imageAsIcon && withImage && ' '}
              {imageAsIcon && withImage && (
                <div class="ct-icon ct-icon--size-extra-large ct-navigation-card__icon__image">
                  <Image theme={theme} url={image?.url} alt={image?.alt} />
                </div>
              )}
            </div>{' '}
          </Fragment>
        )}
        <div class="ct-navigation-card__title">
          {withLink ? (
            <a
              class="ct-navigation-card__title-link"
              href={link?.url}
              target={link?.isNewWindow ? '_blank' : undefined}
            >
              {hasTitleSlot ? <slot name="title" /> : <Fragment set:html={title} />}
            </a>
          ) : hasTitleSlot ? (
            <slot name="title" />
          ) : (
            <Fragment set:html={title} />
          )}
        </div>
        {hasContentMiddle && (
          <Fragment>
            {' '}
            <div class="ct-navigation-card__content-middle">
              {hasContentMiddleSlot ? <slot name="contentMiddle" /> : <Fragment set:html={contentMiddle} />}
            </div>
          </Fragment>
        )}
        {hasSummary && (
          <Fragment>
            {' '}
            {hasSummarySlot ? (
              <slot name="summary" />
            ) : (
              <Paragraph theme={theme} content={summary} noMargin class="ct-navigation-card__summary" />
            )}
          </Fragment>
        )}
        {hasContentBottom && (
          <Fragment>
            {' '}
            <div class="ct-navigation-card__content-bottom">
              {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
            </div>
          </Fragment>
        )}
        {isCardClickable && ' '}
        {isCardClickable && (
          <div class="ct-navigation-card__tags">
            <div class="ct-navigation-card__link-graphic">
              <Icon symbol="right-arrow-2" size="regular" />
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
