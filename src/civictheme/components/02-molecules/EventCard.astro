---
/**
 * CivicTheme Event Card component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - image: Event image: { url, alt }.
 * - isTitleClick: Whether to make only the title clickable instead of the
 *   whole card.
 * - dateIso / date / dateEndIso / dateEnd: Date area content.
 * - link: Optional link: { url, isNewWindow }.
 * - tags: Event tags: string, or { content, url, isNewWindow }.
 * - imageOver / contentTop / title / contentMiddle / location / summary /
 *   contentBottom: Documented as Slots upstream, but every upstream test
 *   passes plain string props — ported as `string` props, ALL rendered
 *   with `set:html` per this project's autoescape convention (see
 *   PORTING.md): every one of these is documented under "Slots:", not
 *   "Props:", including `title` (its `{{ title }}` print inside
 *   `title_content` looks like plain text, but the upstream jest harness
 *   runs with Twig's `autoescape` globally disabled, so that plain print is
 *   raw HTML in every pinned `.snap` fixture already). Each also now has a
 *   same-named Astro slot that TAKES PRECEDENCE over the string prop when
 *   present (Task 14c); every wrapper `{% if %}` gate (root included, via
 *   `title`) widens to `Boolean(prop) || Astro.slots.has('prop')`.
 *   `location`/`summary` route the string-prop branch through `Paragraph`,
 *   so a slot bypasses that wrapper and renders the caller's markup
 *   directly.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 *
 * Note: `event-card.twig`'s `content_tags_block` includes
 * `@molecules/tag-list/tag-list.twig` with exactly `{ theme, tags }` — now
 * ported (Task 10), so this renders a real `<TagList>` with the same two
 * props, rather than inlining its markup.
 */
import Image from '@civictheme/atoms/Image.astro';
import Tag from '@civictheme/atoms/Tag.astro';
import Paragraph from '@civictheme/atoms/Paragraph.astro';
import Icon from '@civictheme/base/Icon.astro';
import TagList from '@civictheme/molecules/TagList.astro';

interface Props {
  theme?: 'light' | 'dark';
  image?: { url?: string; alt?: string };
  isTitleClick?: boolean;
  dateIso?: string | null;
  date?: string;
  dateEndIso?: string | null;
  dateEnd?: string;
  link?: { url?: string; isNewWindow?: boolean };
  tags?: Array<string | { content?: string; url?: string; isNewWindow?: boolean }>;
  imageOver?: string;
  contentTop?: string;
  title?: string;
  contentMiddle?: string;
  location?: string;
  summary?: string;
  contentBottom?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  image,
  isTitleClick,
  dateIso,
  date,
  dateEndIso,
  dateEnd,
  link,
  tags,
  imageOver,
  contentTop,
  title,
  contentMiddle,
  location,
  summary,
  contentBottom,
  class: className = '',
  ...rest
} = Astro.props;

const withImage = Boolean(image?.url);
const withLink = Boolean(link?.url);
const isCardClickable = withLink && !isTitleClick;

const hasImageOverSlot = Astro.slots.has('imageOver');
const hasContentTopSlot = Astro.slots.has('contentTop');
const hasTitleSlot = Astro.slots.has('title');
const hasContentMiddleSlot = Astro.slots.has('contentMiddle');
const hasLocationSlot = Astro.slots.has('location');
const hasSummarySlot = Astro.slots.has('summary');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasImageOver = Boolean(imageOver) || hasImageOverSlot;
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasTitle = Boolean(title) || hasTitleSlot;
const hasContentMiddle = Boolean(contentMiddle) || hasContentMiddleSlot;
const hasLocation = Boolean(location) || hasLocationSlot;
const hasSummary = Boolean(summary) || hasSummarySlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;

const classes = [
  'ct-event-card',
  `ct-theme-${theme}`,
  withImage && 'ct-event-card--with-image',
  hasImageOver && 'ct-event-card--image-over',
  isCardClickable && 'ct-event-card--card-clickable',
  className,
]
  .filter(Boolean)
  .join(' ');

const tagList = tags ?? [];

// `date_content` is passed as `Tag`'s HTML-bearing `content` prop (see
// Tag.astro's note: the upstream jest harness runs with Twig autoescape
// globally disabled, so this is genuinely raw HTML in the pinned
// snapshots). `Tag`'s `content` is a string, not a JSX slot, so `Datetime`
// can't be used as a live child here — its markup is replicated directly
// (mirrors `Datetime.astro`, which is a small, stable, already-ported
// atom) rather than routed through the Container API.
const stripTags = (s: string) => s.replace(/<[^>]*>/g, '');
const escapeAttr = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
function datetimeMarkup(): string {
  if (!date) return '';
  let html = `<span class="ct-datetime"><time class="ct-timestamp__start" datetime="${escapeAttr(stripTags(dateIso || date))}">${date}</time>`;
  if (dateEnd) {
    html += ` — <time class="ct-timestamp__end" datetime="${escapeAttr(stripTags(dateEndIso || dateEnd))}">${dateEnd}</time>`;
  }
  html += '</span>';
  return html;
}
---

{
  hasTitle && (
    <div class={classes} {...rest}>
      {(image?.url || hasImageOver) && (
        <Fragment>
          <div class="ct-event-card__image">
            <Image theme={theme} url={image?.url} alt={image?.alt} />
            {hasImageOver && (
              <Fragment>
                {' '}
                <div class="ct-event-card__image__over">
                  {hasImageOverSlot ? <slot name="imageOver" /> : <Fragment set:html={imageOver} />}
                </div>
              </Fragment>
            )}
          </div>{' '}
        </Fragment>
      )}
      <div class="ct-event-card__content">
        {hasContentTop && (
          <Fragment>
            <div class="ct-event-card__content-top">
              {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
            </div>{' '}
          </Fragment>
        )}
        {date && (
          <Fragment>
            <div class="ct-event-card__date">
              <Tag theme={theme} type="secondary" content={datetimeMarkup()} icon="calendar-2" iconPlacement="before" />
            </div>{' '}
          </Fragment>
        )}
        <div class="ct-event-card__title">
          {withLink ? (
            <a class="ct-event-card__title-link" href={link?.url} target={link?.isNewWindow ? '_blank' : undefined}>
              {hasTitleSlot ? <slot name="title" /> : <Fragment set:html={title} />}
            </a>
          ) : hasTitleSlot ? (
            <slot name="title" />
          ) : (
            <Fragment set:html={title} />
          )}
        </div>
        {hasContentMiddle && (
          <Fragment>
            {' '}
            <div class="ct-event-card__middle">
              {hasContentMiddleSlot ? <slot name="contentMiddle" /> : <Fragment set:html={contentMiddle} />}
            </div>
          </Fragment>
        )}
        {hasLocation && (
          <Fragment>
            {' '}
            {hasLocationSlot ? (
              <slot name="location" />
            ) : (
              <Paragraph theme={theme} content={location} class="ct-event-card__location" />
            )}
          </Fragment>
        )}
        {hasSummary && (
          <Fragment>
            {' '}
            {hasSummarySlot ? (
              <slot name="summary" />
            ) : (
              <Paragraph theme={theme} content={summary} noMargin class="ct-event-card__summary" />
            )}
          </Fragment>
        )}
        {(tagList.length > 0 || withLink) && (
          <Fragment>
            {' '}
            <div class="ct-event-card__tags">
              {tagList.length > 0 && (
                <Fragment>
                  <TagList theme={theme} tags={tagList} />{' '}
                </Fragment>
              )}
              {isCardClickable && (
                <div class="ct-event-card__link-graphic">
                  <Icon symbol="right-arrow-2" size="regular" />
                </div>
              )}
            </div>
          </Fragment>
        )}
        {hasContentBottom && (
          <Fragment>
            {' '}
            <div class="ct-event-card__content-bottom">
              {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
            </div>
          </Fragment>
        )}
      </div>
    </div>
  )
}
