---
/**
 * CivicTheme Publication Card component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - image: Card image: { url, alt }.
 * - file: File object for download: { name, url, ext, size }.
 * - isTitleClick: Whether to make only the title clickable instead of the
 *   whole card.
 * - filenamePrefix: Description of file details for accessibility.
 * - title: Card title text.
 * - imageOver / contentTop / contentMiddle / summary / contentBottom:
 *   Documented as Slots upstream, but every upstream test passes plain
 *   string props — ported as `string` props, ALL rendered with `set:html`
 *   per this project's autoescape convention (see PORTING.md). Each also
 *   now has a same-named Astro slot that TAKES PRECEDENCE over the string
 *   prop when present (Task 14c); every wrapper `{% if %}` gate widens to
 *   `Boolean(prop) || Astro.slots.has('prop')`. `summary` routes the
 *   string-prop branch through `Paragraph`, so a slot bypasses that
 *   wrapper and renders the caller's markup directly.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root element.
 */
import Image from '@civictheme/atoms/Image.astro';
import Paragraph from '@civictheme/atoms/Paragraph.astro';
import Link from '@civictheme/atoms/Link.astro';
import Icon from '@civictheme/base/Icon.astro';

interface FileInfo {
  name?: string;
  url?: string;
  ext?: string;
  size?: string;
}

interface Props {
  theme?: 'light' | 'dark';
  image?: { url?: string; alt?: string };
  file?: FileInfo;
  isTitleClick?: boolean;
  filenamePrefix?: string;
  title?: string;
  imageOver?: string;
  contentTop?: string;
  contentMiddle?: string;
  summary?: string;
  contentBottom?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  theme = 'light',
  image,
  file,
  isTitleClick,
  filenamePrefix: filenamePrefixProp,
  title,
  imageOver,
  contentTop,
  contentMiddle,
  summary,
  contentBottom,
  class: className = '',
  ...rest
} = Astro.props;

const withImage = Boolean(image?.url);
const withFile = Boolean(file?.url);
const isCardClickable = withFile && !isTitleClick && Boolean(title);

const classes = [
  'ct-publication-card',
  `ct-theme-${theme}`,
  withImage && 'ct-publication-card--with-image',
  isCardClickable && 'ct-publication-card--card-clickable',
  className,
]
  .filter(Boolean)
  .join(' ');

const filenamePrefix = filenamePrefixProp || 'File details:';
const hasExt = Boolean(file?.ext);
const hasSize = Boolean(file?.size);
const extensionTextRaw = hasExt && hasSize ? `${file?.ext}, ${file?.size}` : file?.ext || file?.size || '';
const extensionText = extensionTextRaw ? `(${extensionTextRaw})` : '';
const filenameText = file?.name || '';
const filename = `${filenameText} ${extensionText}`.trim();

const titleLabel = withFile && filename ? `${title}. ${filenamePrefix} ${filename}` : '';

// publication-card.twig gates on `file is not empty` — Twig's `empty` test
// on an object/array checks its element count, so `file: {}` (no keys) is
// "empty" and must not render, unlike a plain JS truthiness check on `{}`.
const hasFile = Boolean(file && Object.keys(file).length > 0);

const hasImageOverSlot = Astro.slots.has('imageOver');
const hasContentTopSlot = Astro.slots.has('contentTop');
const hasContentMiddleSlot = Astro.slots.has('contentMiddle');
const hasSummarySlot = Astro.slots.has('summary');
const hasContentBottomSlot = Astro.slots.has('contentBottom');
const hasImageOver = Boolean(imageOver) || hasImageOverSlot;
const hasContentTop = Boolean(contentTop) || hasContentTopSlot;
const hasContentMiddle = Boolean(contentMiddle) || hasContentMiddleSlot;
const hasSummary = Boolean(summary) || hasSummarySlot;
const hasContentBottom = Boolean(contentBottom) || hasContentBottomSlot;
---

{
  hasFile && (
    <div class={classes} {...rest}>
      {image?.url && (
        <Fragment>
          <div class="ct-publication-card__image">
            <Image theme={theme} url={image.url} alt={image.alt} />
            {hasImageOver && (
              <Fragment>
                {' '}
                <div class="ct-publication-card__image__over">
                  {hasImageOverSlot ? <slot name="imageOver" /> : <Fragment set:html={imageOver} />}
                </div>
              </Fragment>
            )}
          </div>{' '}
        </Fragment>
      )}
      <div class="ct-publication-card__content">
        {hasContentTop && (
          <Fragment>
            <div class="ct-publication-card__content-top">
              {hasContentTopSlot ? <slot name="contentTop" /> : <Fragment set:html={contentTop} />}
            </div>{' '}
          </Fragment>
        )}
        {title && (
          <Fragment>
            <div class="ct-publication-card__title-bar">
              <div class="ct-publication-card__title">
                {withFile ? (
                  <a class="ct-publication-card__title-link" href={file?.url} aria-label={titleLabel || undefined}>
                    {title}
                  </a>
                ) : (
                  title
                )}
              </div>{' '}
              <Icon symbol="download" size="regular" class="ct-publication-card__title-icon" />
            </div>{' '}
          </Fragment>
        )}
        {hasContentMiddle && (
          <Fragment>
            <div class="ct-publication-card__content__middle">
              {hasContentMiddleSlot ? <slot name="contentMiddle" /> : <Fragment set:html={contentMiddle} />}
            </div>{' '}
          </Fragment>
        )}
        {hasSummary && (
          <Fragment>
            {hasSummarySlot ? (
              <slot name="summary" />
            ) : (
              <Paragraph theme={theme} content={summary} noMargin class="ct-publication-card__summary" />
            )}{' '}
          </Fragment>
        )}
        {filename &&
          (title ? (
            <div class="ct-publication-card__filename">
              <span class="ct-visually-hidden">{filenamePrefix}</span> {filename}
            </div>
          ) : (
            <Link theme={theme} text={filename} url={file?.url} class="ct-publication-card__link" />
          ))}{' '}
        {hasContentBottom && (
          <div class="ct-publication-card__content-bottom">
            {hasContentBottomSlot ? <slot name="contentBottom" /> : <Fragment set:html={contentBottom} />}
          </div>
        )}
      </div>
    </div>
  )
}
