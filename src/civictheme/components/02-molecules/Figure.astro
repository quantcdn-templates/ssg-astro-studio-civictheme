---
/**
 * CivicTheme Figure component.
 *
 * Props:
 * - theme: Theme variation (light or dark).
 * - url: Image URL (required to render anything).
 * - alt: Image alt text.
 * - width / height: Image dimensions.
 * - caption: Image caption (HTML-bearing — rendered with `set:html`).
 *   Documented as a Slot upstream (not under "Props:"), so per this
 *   project's autoescape convention (see PORTING.md) it is treated as
 *   HTML-bearing even though the twig body prints it with a plain
 *   `{{ caption }}` (no `|raw`) — the upstream jest harness runs with
 *   Twig's `autoescape` globally disabled, so that plain print is raw HTML
 *   in every pinned `.snap` fixture already. Also has a same-named Astro
 *   slot that TAKES PRECEDENCE over the string prop when present (Task
 *   14c); its wrapper gate widens to
 *   `Boolean(caption) || Astro.slots.has('caption')`.
 * - class: Additional CSS classes.
 * - ...rest: Additional HTML attributes, spread onto the root <figure>.
 */
import Image from '@civictheme/atoms/Image.astro';
import Icon from '@civictheme/base/Icon.astro';

interface Props {
  theme?: 'light' | 'dark';
  url?: string;
  alt?: string;
  width?: number | null;
  height?: number | null;
  caption?: string;
  class?: string;
  [key: string]: unknown;
}

const { theme = 'light', url, alt, width, height, caption, class: className = '', ...rest } = Astro.props;

const classes = ['ct-figure', `ct-theme-${theme}`, className].filter(Boolean).join(' ');

const hasCaptionSlot = Astro.slots.has('caption');
const hasCaption = Boolean(caption) || hasCaptionSlot;
---

{
  url && (
    <figure class={classes} {...rest}>
      <Image theme={theme} url={url} alt={alt} width={width} height={height} class="ct-figure__image" />
      {hasCaption && (
        <Fragment>
          {' '}
          <figcaption class="ct-figure__caption">
            <Icon symbol="image" /> {hasCaptionSlot ? <slot name="caption" /> : <Fragment set:html={caption} />}
          </figcaption>
        </Fragment>
      )}
    </figure>
  )
}
