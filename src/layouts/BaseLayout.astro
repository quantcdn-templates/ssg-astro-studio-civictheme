---
/**
 * Base HTML document for every route.
 *
 * Owns the single `global.scss` import, the head metadata, the skip link,
 * alerts, header, footer, back-to-top and the one hoisted CivicTheme JS
 * init script. There is deliberately NO `<ClientRouter>`: the vendored
 * behaviours self-initialise at module evaluation and would not re-run after
 * a view transition (see PORTING.md).
 *
 * Fonts: CivicTheme's own SCSS `@import`s Lexend and Public Sans from Google
 * Fonts, so the head only adds the two preconnects.
 *
 * Page background: `ct-page` sits on the `<body>`, not on the centred content
 * wrapper. CivicTheme's `.ct-page` rule (`scss/04-templates/page/page.scss`)
 * paints the themed page background, and in Drupal `.ct-page` IS the
 * full-width page element. On the body the background covers the whole
 * viewport, so a `theme: dark` page renders dark-theme text on the dark page
 * background instead of on the browser's white canvas.
 *
 * Dismissed alerts: the inline head script hides every alert id in the
 * `ct-alert-hide` cookie before first paint, so a dismissed alert does not
 * flash in and out. The shim in `src/civictheme/js/civictheme.js` then
 * removes the matching alerts and that style, so an alert whose content
 * changed since it was dismissed shows again, as upstream's hash check
 * intends.
 */
import '@/styles/global.scss';
import SkipLink from '@civictheme/organisms/SkipLink.astro';
import BackToTop from '@civictheme/molecules/BackToTop.astro';
import SiteAlerts from '@/components/SiteAlerts.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { cleanPath } from '@/lib/url';
import { siteSettings } from '@/lib/content';

interface Props {
  title: string;
  description?: string;
  /**
   * OG image path, relative to the site root. Required: a default would let a
   * route that forgot the prop silently reuse another page's social card.
   */
  image: string;
  theme?: 'light' | 'dark';
}

const { title, description = '', image, theme = 'light' } = Astro.props;

// `build.format: 'file'` makes `Astro.url.pathname` the built file path, so
// canonical and og:url go through `cleanPath` to match the sitemap's URLs.
const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(cleanPath(Astro.url.pathname), site).href;
const ogImage = new URL(image, site).href;
const { favicon = '/favicon.svg' } = await siteSettings();
const faviconType = favicon.endsWith('.svg') ? 'image/svg+xml' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type={faviconType} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        var match = document.cookie.match(/(?:^|;\s*)ct-alert-hide=([^;]*)/);
        if (!match || !window.CSS || !CSS.escape) return;
        try {
          var ids = Object.keys(JSON.parse(match[1]) || {});
          if (ids.length === 0) return;
          var style = document.createElement('style');
          style.id = 'ct-alert-prehide';
          style.textContent =
            ids
              .map(function (id) {
                return '[data-component-name="ct-alert"][data-alert-id="' + CSS.escape(id) + '"]';
              })
              .join(',') + '{display:none!important}';
          document.head.appendChild(style);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={`ct-page ct-theme-${theme}`}>
    <SkipLink theme={theme} url="#main-content" />
    <SiteAlerts theme={theme} />
    <SiteHeader theme={theme} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter theme="dark" />
    <BackToTop />
    <script>
      import '@/civictheme/js/civictheme.js';
      import { focusFormResult } from '@/lib/quant-form-result';
      import { labelPageContentTables } from '@/lib/page-content-tables';

      focusFormResult(document);
      labelPageContentTables(document);
    </script>
  </body>
</html>
