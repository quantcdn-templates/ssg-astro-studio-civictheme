---
/**
 * Home page: the `pages` collection entry with id `index`, on `PageLayout`.
 * Every other `pages` entry is routed by `[...slug].astro`, which skips this
 * one to avoid a duplicate route.
 */
import { getEntry, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { components } from '@/components/MdxComponents';

const entry = await getEntry('pages', 'index');
if (!entry) throw new Error('src/content/pages/index.mdx is missing');
const { Content } = await render(entry);
---

<PageLayout entry={entry}>
  <Content components={components} />
</PageLayout>
