---
/**
 * News listing, ten entries per page (`PAGE_SIZE`).
 *
 * A rest parameter keeps page 1 at `/news`, and `listingPaths` puts later
 * pages under a `page/` segment — `/news/page/2`, `/news/page/3`, … That
 * segment keeps the pager out of the sibling `[slug].astro` route's
 * namespace: without it, `/news/2` would be both the second pager page
 * and the detail page of an entry whose id is `2`.
 */
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import ListingAuto from '@/components/ListingAuto.astro';
import { listPublished } from '@/lib/content';
import { listingPaths } from '@/lib/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await listPublished('news');
  return listingPaths(paginate, entries);
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'news'>> };

const title = 'News';
const summary = 'Browse all published news from Your organisation.';
---

<BaseLayout title={title} description={summary} image="/og/news.png">
  <PageBanner
    title={title}
    summary={summary}
    breadcrumbLinks={[
      { text: 'Home', url: '/' },
      { text: title, url: '/news' },
    ]}
    backgroundImage="/civictheme/backgrounds/civictheme_background_3.png"
  />
  <div class="ct-vertical-spacing-inset--both">
    <ListingAuto collection="news" entries={page.data} page={page} pageBase="/news" />
  </div>
</BaseLayout>
