  <style>
    .components-icon-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
      gap: 1rem;
      list-style: none;
      margin: 0 0 1rem;
      padding: 0;
    }

    .components-icon-grid li {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.7rem;
