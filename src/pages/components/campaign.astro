---
/**
 * Campaign reference page (Task 17). Every captured `03-organisms/campaign`
 * story, light and dark.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentDemoBlock from '@/components/ComponentDemoBlock.astro';
import Campaign from '@civictheme/organisms/Campaign.astro';
import { storiesFor, propsFor, componentTagName } from '@/lib/component-demos';

const stories = storiesFor('03-organisms/campaign');
---

<BaseLayout title="CivicTheme — Campaign" description="Every Campaign variant, light and dark." image="/og/home.png">
  <div class="ct-basic-content">
    <h1>Campaign</h1>
    <p>The campaign call-to-action organism.</p>
  </div>
  {
    stories.map((fixture) => {
      const props = propsFor(fixture);
      return (
        <ComponentDemoBlock
          heading={fixture.name}
          tag={componentTagName(fixture.component)}
          props={props}
          theme={fixture.theme}
        >
          <Campaign {...props} />
        </ComponentDemoBlock>
      );
    })
  }
</BaseLayout>
