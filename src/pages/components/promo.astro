---
/**
 * Promo reference page (Task 17). Every captured `03-organisms/promo`
 * story, light and dark.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentDemoBlock from '@/components/ComponentDemoBlock.astro';
import Promo from '@civictheme/organisms/Promo.astro';
import { storiesFor, propsFor, componentTagName } from '@/lib/component-demos';

const stories = storiesFor('03-organisms/promo');
---

<BaseLayout title="CivicTheme — Promo" description="Every Promo variant, light and dark." image="/og/home.png">
  <div class="ct-basic-content">
    <h1>Promo</h1>
    <p>The full-width promotional organism.</p>
  </div>
  {
    stories.map((fixture) => {
      const props = propsFor(fixture);
      return (
        <ComponentDemoBlock
          heading={fixture.name}
          tag={componentTagName(fixture.component)}
          props={props}
          theme={fixture.theme}
        >
          <Promo {...props} />
        </ComponentDemoBlock>
      );
    })
  }
</BaseLayout>
