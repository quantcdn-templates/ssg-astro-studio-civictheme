---
/**
 * Callout reference page (Task 17). Every captured `02-molecules/callout`
 * story, light and dark.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentDemoBlock from '@/components/ComponentDemoBlock.astro';
import Callout from '@civictheme/molecules/Callout.astro';
import { storiesFor, propsFor, componentTagName } from '@/lib/component-demos';

const stories = storiesFor('02-molecules/callout');
---

<BaseLayout title="CivicTheme — Callout" description="Every Callout variant, light and dark." image="/og/home.png">
  <div class="ct-basic-content">
    <h1>Callout</h1>
    <p>Inline highlighted content callouts.</p>
  </div>
  {
    stories.map((fixture) => {
      const props = propsFor(fixture);
      return (
        <ComponentDemoBlock
          heading={fixture.name}
          tag={componentTagName(fixture.component)}
          props={props}
          theme={fixture.theme}
        >
          <Callout {...props} />
        </ComponentDemoBlock>
      );
    })
  }
</BaseLayout>
