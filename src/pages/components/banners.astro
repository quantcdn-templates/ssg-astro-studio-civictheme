---
/**
 * Banners reference page (Task 17). Every captured `03-organisms/banner`
 * story, light and dark.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentDemoBlock from '@/components/ComponentDemoBlock.astro';
import Banner from '@civictheme/organisms/Banner.astro';
import { storiesFor, propsFor, componentTagName } from '@/lib/component-demos';

const stories = storiesFor('03-organisms/banner');
---

<BaseLayout title="CivicTheme — Banners" description="Every Banner variant, light and dark." image="/og/home.png">
  <div class="ct-basic-content">
    <h1>Banners</h1>
    <p>The page-header banner organism, in every captured variant.</p>
  </div>
  {
    stories.map((fixture) => {
      const props = propsFor(fixture);
      return (
        <ComponentDemoBlock
          heading={fixture.name}
          tag={componentTagName(fixture.component)}
          props={props}
          theme={fixture.theme}
        >
          <Banner {...props} />
        </ComponentDemoBlock>
      );
    })
  }
</BaseLayout>
