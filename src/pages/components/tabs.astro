---
/**
 * Tabs reference page (Task 17). Every captured `02-molecules/tabs` story,
 * light and dark.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentDemoBlock from '@/components/ComponentDemoBlock.astro';
import Tabs from '@civictheme/molecules/Tabs.astro';
import { storiesFor, propsFor, componentTagName } from '@/lib/component-demos';

const stories = storiesFor('02-molecules/tabs');
---

<BaseLayout title="CivicTheme — Tabs" description="Every Tabs variant, light and dark." image="/og/home.png">
  <div class="ct-basic-content">
    <h1>Tabs</h1>
    <p>Tabbed content panels.</p>
  </div>
  {
    stories.map((fixture) => {
      const props = propsFor(fixture);
      return (
        <ComponentDemoBlock
          heading={fixture.name}
          tag={componentTagName(fixture.component)}
          props={props}
          theme={fixture.theme}
        >
          <Tabs {...props} />
        </ComponentDemoBlock>
      );
    })
  }
</BaseLayout>
