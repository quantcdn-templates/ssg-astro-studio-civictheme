---
/**
 * Accordion reference page (Task 17). Every captured
 * `02-molecules/accordion` story, light and dark.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentDemoBlock from '@/components/ComponentDemoBlock.astro';
import Accordion from '@civictheme/molecules/Accordion.astro';
import { storiesFor, propsFor, componentTagName } from '@/lib/component-demos';

const stories = storiesFor('02-molecules/accordion');
---

<BaseLayout title="CivicTheme — Accordion" description="Every Accordion variant, light and dark." image="/og/home.png">
  <div class="ct-basic-content">
    <h1>Accordion</h1>
    <p>Expandable/collapsible content panels.</p>
  </div>
  {
    stories.map((fixture) => {
      const props = propsFor(fixture);
      return (
        <ComponentDemoBlock
          heading={fixture.name}
          tag={componentTagName(fixture.component)}
          props={props}
          theme={fixture.theme}
        >
          <Accordion {...props} />
        </ComponentDemoBlock>
      );
    })
  }
</BaseLayout>
