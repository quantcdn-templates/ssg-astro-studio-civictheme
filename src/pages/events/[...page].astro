---
/**
 * Events listing, ten entries per page (`PAGE_SIZE`).
 *
 * A rest parameter keeps page 1 at `/events` and puts later pages at
 * `/events/2`, `/events/3`, … The sibling `[slug].astro` route owns the
 * detail pages; a numeric entry id would be the only way the two could
 * collide.
 */
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import ListingAuto from '@/components/ListingAuto.astro';
import { listPublished } from '@/lib/content';
import { listingPaths } from '@/lib/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await listPublished('events');
  return listingPaths(paginate, entries);
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'events'>> };

const title = 'Events';
const summary = 'Browse all published events from Your organisation.';
---

<BaseLayout title={title} description={summary} image="/og/events.png">
  <PageBanner
    title={title}
    summary={summary}
    breadcrumbLinks={[
      { text: 'Home', url: '/' },
      { text: title, url: '/events' },
    ]}
    backgroundImage="/civictheme/backgrounds/civictheme_background_3.png"
  />
  <div class="ct-vertical-spacing-inset--both">
    <ListingAuto collection="events" entries={page.data} page={page} pageBase="/events" />
  </div>
</BaseLayout>
