---
/**
 * Events listing.
 *
 * The demo content set holds six or fewer published entries per collection,
 * so the route renders a single unpaginated page. When a collection grows
 * past ten entries, rename this file to `[...page].astro` and wrap
 * `ListingGrid` in Astro's `paginate()` with `pageSize: 10`, adding the
 * `Pagination` molecule below the grid.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import ListingAuto from '@/components/ListingAuto.astro';

const title = 'Events';
const summary = 'Browse all published events from Your organisation.';
---

<BaseLayout title={title} description={summary} image="/og/events.png">
  <PageBanner
    title={title}
    summary={summary}
    breadcrumbLinks={[
      { text: 'Home', url: '/' },
      { text: title, url: '/events' },
    ]}
    backgroundImage="/civictheme/backgrounds/civictheme_background_3.png"
  />
  <div class="ct-vertical-spacing-inset--both">
    <ListingAuto collection="events" />
  </div>
</BaseLayout>
