---
/**
 * Shared card-grid renderer used by `ListingAuto`, `ManualList` and the
 * paginated listing routes.
 *
 * `List`/`Grid` accept real Astro slots (Task 14b) in addition to their
 * pre-rendered-string props, so this composes `List` (rows via
 * `<Fragment slot="rows">`, the pager via `<Fragment slot="pagination">`)
 * instead of inlining their wrapper markup — real card components are live
 * children throughout, with no HTML-string pre-rendering step.
 *
 * `Grid` is used with `useContainer={false}` and its own `.container` div
 * built in `ListingRows` instead, so the rendered `.ct-list__rows` div (from
 * `List`'s `rows` slot wrapper) doesn't also duplicate `Grid`'s own
 * `aria-live="polite"` container attribute — see PORTING.md for the resulting
 * (semantically inert) markup delta against the pre-Task-14b inlined version.
 *
 * The two `<List>` branches are deliberate: Astro registers a named slot at
 * compile time, so a conditional `<Fragment slot="pagination">` would open an
 * empty `.ct-list__pagination` wrapper on every unpaginated listing. The
 * shared props live in one `listProps` object and the rows in `ListingRows`.
 */
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';
import List from '@civictheme/organisms/List.astro';
import Pagination from '@civictheme/molecules/Pagination.astro';
import ListingRows from './ListingRows.astro';
import { paginationItems } from '@/lib/pagination';
import type { CardCollection } from '@/lib/content';

interface Props {
  collection: CardCollection;
  entries: CollectionEntry<CardCollection>[];
  title?: string;
  theme?: 'light' | 'dark';
  columns?: 2 | 3 | 4;
  /** Astro `paginate()` page, when the listing route is paginated. */
  page?: Pick<Page, 'currentPage' | 'lastPage'>;
  /** Base path the pager builds its hrefs from, e.g. `/events`. */
  pageBase?: string;
  /** Passed through to `List`: inset vertical spacing (`top`, `bottom` or `both`). */
  verticalSpacing?: 'top' | 'bottom' | 'both';
}

const { collection, entries, title, theme = 'light', columns = 3, page, pageBase = '', verticalSpacing } = Astro.props;

const listProps = { title, theme, verticalSpacing, class: 'ct-listing-grid' };
const rowsProps = { collection, entries, theme, columns };
const showPager = Boolean(page && page.lastPage > 1);
const pagerItems = page ? paginationItems(page, pageBase) : undefined;
---

{
  showPager ? (
    <List {...listProps}>
      <Fragment slot="rows">
        <ListingRows {...rowsProps} />
      </Fragment>
      <Fragment slot="pagination">
        <Pagination
          theme={theme}
          items={pagerItems}
          current={page?.currentPage}
          totalPages={page?.lastPage}
          headingId={`${collection}-pagination`}
        />
      </Fragment>
    </List>
  ) : (
    <List {...listProps}>
      <Fragment slot="rows">
        <ListingRows {...rowsProps} />
      </Fragment>
    </List>
  )
}
