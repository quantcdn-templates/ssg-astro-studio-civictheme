---
/**
 * Curated listing: renders a specific, ordered set of entries (by `id`)
 * from one card collection with `ListingGrid` (see that component's header
 * comment for why `List`/`Grid` aren't used directly).
 */
import { getEntry } from 'astro:content';
import ListingGrid from './ListingGrid.astro';
import type { CardCollection } from '../lib/content';

interface Props {
  collection: CardCollection;
  slugs: string[];
  title?: string;
  theme?: 'light' | 'dark';
  columns?: 2 | 3 | 4;
}

const { collection, slugs, title, theme = 'light', columns = 3 } = Astro.props;
const fetched = await Promise.all(slugs.map((slug) => getEntry(collection, slug)));
const entries = fetched.filter((entry): entry is NonNullable<typeof entry> => Boolean(entry) && !entry?.data.draft);
---

<ListingGrid collection={collection} entries={entries} title={title} theme={theme} columns={columns} />
