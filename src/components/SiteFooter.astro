---
/**
 * Site footer composition.
 *
 * Live components inside the `Footer` organism's named slots (Task 15, see
 * PORTING.md). Slot allocation follows upstream `footer.stories.data.js`:
 * `Logo` in `contentTop1`, `SocialLinks` in `contentTop2`, the footer menu in
 * `contentMiddle1`, the site's own contact details (when the source had a
 * "Contact us" block) in `contentMiddle2`, the acknowledgement in
 * `contentBottom1` and the copyright in `contentBottom2`.
 */
import Footer from '@civictheme/organisms/Footer.astro';
import Logo from '@civictheme/molecules/Logo.astro';
import Navigation from '@civictheme/organisms/Navigation.astro';
import SocialLinks from '@civictheme/molecules/SocialLinks.astro';
import Heading from '@civictheme/atoms/Heading.astro';
import Link from '@civictheme/atoms/Link.astro';
import { siteSettings, menu, humanise } from '@/lib/content';

interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'dark' } = Astro.props;
const site = await siteSettings();
const footerMenu = await menu('footer');

const logoUrl = theme === 'dark' ? site.logoDark : site.logoLight;
const logos = {
  primary: {
    mobile: { url: logoUrl, alt: site.name },
    desktop: { url: logoUrl, alt: site.name },
  },
};

const socialItems = site.social.map((link) => ({
  title: humanise(link.platform),
  url: link.url,
  icon: link.platform,
}));

const year = new Date().getFullYear();

/** A line that is (almost) entirely digits/spaces/punctuation reads as a phone number -- linked as `tel:`, digits only, so a "1300 363 992"-style source number still dials correctly. */
const isPhoneLine = (line: string) => /^[+()0-9][0-9 ()-]{5,}$/.test(line.trim());
const telHref = (line: string) => `tel:${line.replace(/[^0-9+]/g, '')}`;
---

<Footer theme={theme}>
  <Fragment slot="contentTop1">
    <Logo theme={theme} logos={logos} url="/" title={site.name} />
  </Fragment>
  <Fragment slot="contentTop2">
    <SocialLinks theme={theme} withBorder items={socialItems} />
  </Fragment>
  <Fragment slot="contentMiddle1">
    <Navigation theme={theme} items={footerMenu} name="footer" type="none" title={site.name} />
  </Fragment>
  {
    site.footerContact && (
      <Fragment slot="contentMiddle2">
        <div class={`ct-footer__contact ct-theme-${theme}`}>
          <Heading theme={theme} level="3" content={site.footerContact.heading} class="ct-heading--no-margin" />
          {
            // CivicTheme paragraph classes with escaped text: these lines are
            // plain settings text, and Paragraph renders `content` as HTML.
            site.footerContact.lines.map((line) => (
              <div class={`ct-paragraph ct-theme-${theme} ct-paragraph--regular ct-paragraph--no-margin`}>
                {isPhoneLine(line) ? <Link theme={theme} text={line} url={telHref(line)} /> : line}
              </div>
            ))
          }
        </div>
      </Fragment>
    )
  }
  <Fragment slot="contentBottom1">
    {site.acknowledgement && <div class="ct-footer__acknowledgement ct-text-regular">{site.acknowledgement}</div>}
  </Fragment>
  <Fragment slot="contentBottom2">
    <div class="copyright ct-text-regular">© {year} {site.name}</div>
  </Fragment>
</Footer>
