        "defaults": {
          "panels": [
            {
              "id": "tab-1",
              "title": "Tab 1",
              "content": "Tab text."
            }
          ]
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/BasicContent.astro",
        "group": "content",
        "description": "Rich text block.",
        "defaults": {
          "content": "<p>Rich text.</p>"
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/TableOfContents.astro",
        "group": "content",
        "description": "In-page navigation built from headings.",
        "defaults": {
          "title": "On this page",
          "scopeSelector": ".ct-basic-content"
        }
      },
      {
        "path": "src/civictheme/components/01-atoms/Table.astro",
        "group": "content",
        "description": "Data table.",
        "defaults": {
          "header": [
            "Column 1",
            "Column 2"
