          "rows": [
            [
              "Cell",
              "Cell"
            ]
          ]
        }
      },
      {
        "path": "src/civictheme/components/03-organisms/Webform.astro",
        "group": "content",
        "description": "Form wrapper (form markup goes in the referencedWebform slot)."
      },
      {
        "path": "src/components/ManualList.astro",
        "group": "listings",
        "description": "Chosen entries from one collection.",
        "defaults": {
          "collection": "news",
          "slugs": [],
          "title": "Related"
        }
      },
      {
        "path": "src/components/ListingAuto.astro",
        "group": "listings",
        "description": "Latest entries from one collection.",
        "defaults": {
          "collection": "news",
          "limit": 3,
          "title": "Latest news"
        }
      },
      {
        "path": "src/civictheme/components/03-organisms/Slider.astro",
