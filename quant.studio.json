{
  "_components": {
    "groups": [
      {
        "id": "content",
        "label": "Content"
      },
      {
        "id": "listings",
        "label": "Listings"
      },
      {
        "id": "media",
        "label": "Media"
      },
      {
        "id": "layout",
        "label": "Layout"
      }
    ],
    "imports": "none",
    "props": {
      "icon": {
        "widget": "icon"
      },
      "modifierClass": {
        "group": "advanced"
      },
      "summary": {
        "widget": "textarea"
      },
      "content": {
        "widget": "textarea"
      },
      "contentTop": {
        "widget": "textarea"
      },
      "contentMiddle": {
        "widget": "textarea"
      },
      "contentBottom": {
        "widget": "textarea"
      },
      "imageOver": {
        "widget": "textarea"
      }
    },
    "icons": {
      "source": "src/civictheme/components/00-base/icons.ts"
    },
    "items": [
      {
        "path": "src/civictheme/components/02-molecules/Callout.astro",
        "group": "content",
        "description": "Highlighted message with optional links.",
        "defaults": {
          "title": "Callout title",
          "content": "Callout text."
        }
      },
      {
        "path": "src/civictheme/components/03-organisms/Promo.astro",
        "group": "content",
        "description": "Call-to-action band with a link.",
        "defaults": {
          "title": "Promo title",
          "content": "Promo text.",
          "link": {
            "text": "Find out more",
            "url": "/"
          }
        }
      },
      {
        "path": "src/civictheme/components/03-organisms/Campaign.astro",
        "group": "content",
        "description": "Image and text campaign block.",
        "defaults": {
          "title": "Campaign title",
          "content": "Campaign text."
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/NextStep.astro",
        "group": "content",
        "description": "Next step call-out.",
        "defaults": {
          "title": "Next step",
          "content": "What to do next.",
          "link": {
            "url": "/"
          }
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/Accordion.astro",
        "group": "content",
        "description": "Expandable panels.",
        "defaults": {
          "panels": [
            {
              "title": "Panel 1",
              "content": "Panel text."
            }
          ]
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/Tabs.astro",
        "group": "content",
