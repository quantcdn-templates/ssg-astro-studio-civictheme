        "defaults": {
          "title": "Card title",
          "summary": "Card summary.",
          "link": {
            "text": "Read more",
            "url": "/"
          }
        },
        "props": {
          "image": {
            "label": "Image"
          },
          "link": {
            "label": "Link"
          },
          "summary": {
            "label": "Summary"
          }
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/SubjectCard.astro",
        "group": "listings",
        "defaults": {
          "title": "Subject",
          "link": {
            "url": "/"
          }
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/Attachment.astro",
        "group": "media",
        "description": "Downloadable file.",
        "defaults": {
          "title": "Attachments",
          "files": []
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/Figure.astro",
        "group": "media",
        "description": "Image with caption.",
        "defaults": {
          "url": "/civictheme/demo/demo1.jpg",
          "alt": "",
          "caption": "Caption"
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/Map.astro",
        "group": "media",
        "description": "Embedded map.",
        "defaults": {
          "url": "https://maps.google.com/maps?q=Melbourne&output=embed",
          "address": "Melbourne"
        }
      },
      {
        "path": "src/civictheme/components/02-molecules/VideoPlayer.astro",
        "group": "media",
        "description": "Video embed."
      },
      {
        "path": "src/civictheme/components/01-atoms/Iframe.astro",
        "group": "media",
        "description": "Embedded frame.",
        "defaults": {
          "url": "https://example.com"
        }
      },
      {
        "path": "src/civictheme/components/00-base/Grid.astro",
        "group": "layout",
        "description": "Column grid; put cards inside.",
        "defaults": {
          "templateColumnCount": 2
        },
        "props": {
          "templateColumnCount": {
            "label": "Columns",
            "help": "How many cards sit side by side on a wide screen.",
            "options": [
              1,
              2,
              3,
              4,
              6,
              12
            ]
          }
        }
      },
      {
        "path": "src/civictheme/components/01-atoms/Heading.astro",
        "group": "layout",
        "defaults": {
          "content": "Heading",
          "level": 2
        }
      },
      {
        "path": "src/civictheme/components/01-atoms/Paragraph.astro",
        "group": "layout",
        "defaults": {
          "content": "Paragraph text."
        }
      },
      {
        "path": "src/civictheme/components/01-atoms/Button.astro",
        "group": "layout",
        "defaults": {
          "text": "Button",
          "url": "/",
          "kind": "link",
          "type": "primary"
        },
        "props": {
          "text": {
            "label": "Button text"
          },
          "url": {
            "label": "Link"
          },
          "iconPlacement": {
            "label": "Icon position"
          }
        }
      }
